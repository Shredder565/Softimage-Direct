{
  "name": "afterimage",
  "productName": "AfterImage",
  "version": "1.0.29",
  "description": "AfterImage - clean-room Softimage-faithful 3D modeling and animation (Electron + native dual track)",
  "author": "AfterImage",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test:frost": "node tools/frost_eval_check.mjs",
    "electron:dev": "ELECTRON_DEV=1 electron .",
    "dist": "npm run build && electron-builder --win nsis",
    "build:win": "npm run build && electron-builder --win nsis --x64",
    "pack": "npm run build && electron-builder --dir"
  },
  "dependencies": {
    "three": "0.170.0",
    "three-bvh-csg": "^0.0.17",
    "three-mesh-bvh": "^0.8.3"
  },
  "devDependencies": {
    "@types/three": "0.170.0",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "playwright": "^1.48.2",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}
