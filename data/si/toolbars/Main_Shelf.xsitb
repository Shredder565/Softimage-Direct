            </item>
            <item type="scriptbutton" label="Ray Poly" userwidth="36" userheight="36" bitmap="raycastpoly" scriptengine="VBScript" tooltip="Raycast Polygon Selection Mode (U)">
               <scripttext>&lt;![CDATA[
                  ActivateRaycastPolySelTool
                  if GetValue(&quot;preferences.TransformProperties.transformmanipulators&quot;) = True And GetValue(&quot;preferences.TransformProperties.transformmanipdefaultxfo&quot;) &lt;&gt; 3 then
                     ActivateSelectTool
                  end if]]&gt;</scripttext>
            </item>
