            <item type="scriptbutton" label="Frame" userwidth="36" userheight="36" bitmap="framesel" scriptengine="VBScript" tooltip="Frame Selection (F) - Active Viewport">
               <scripttext>&lt;![CDATA[
                  vw = GetFocusedViewport
                  if vw = &quot;A&quot; then
                     FrameSelection false, false, 0
                  elseif vw = &quot;B&quot; then
                     FrameSelection false, false, 1
                  elseif vw = &quot;C&quot; then
                     FrameSelection false, false, 2
                  elseif vw = &quot;D&quot; then
                     FrameSelection false, false, 3
                  end if]]&gt;</scripttext>
            </item>
            <item type="scriptbutton" label="All" userwidth="36" userheight="36" bitmap="frameall" scriptengine="VBScript" tooltip="Frame All (A) - Active Viewport">
               <scripttext>&lt;![CDATA[
                  vw = GetFocusedViewport
                  if vw = &quot;A&quot; then
                     FrameSelection true, false, 0
                  elseif vw = &quot;B&quot; then
                     FrameSelection true, false, 1
                  elseif vw = &quot;C&quot; then
                     FrameSelection true, false, 2
                  elseif vw = &quot;D&quot; then
                     FrameSelection true, false, 3
                  end if]]&gt;</scripttext>
            </item>
            <item type="scriptbutton" label="Reset" userwidth="36" userheight="36" bitmap="resetcamera" scriptengine="VBScript" tooltip="Reset Camera (R)  - Active Viewport">
               <scripttext>&lt;![CDATA[
                  vw = GetFocusedViewport
                  if vw = &quot;A&quot; then
                     CameraReset 0
                  elseif vw = &quot;B&quot; then
                     CameraReset 1
                  elseif vw = &quot;C&quot; then
                     CameraReset 2
                  elseif vw = &quot;D&quot; then
                     CameraReset 3
                  end if]]&gt;</scripttext>
            </item>
