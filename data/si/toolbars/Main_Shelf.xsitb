            <item type="scriptbutton" label="Stats" userwidth="36" userheight="36" bitmap="stats" scriptengine="VBScript" tooltip="Show Scene Stats (Active Viewport)">
               <scripttext>&lt;![CDATA[oCam = GetViewCamera(-1) &amp; &quot;.camvis.&quot;
if GetValue (oCam &amp; &quot;selectioninfo&quot;) = True then
	SetValue oCam &amp; &quot;refreshrate,&quot; &amp; oCam &amp; &quot;currenttime,&quot; &amp; oCam &amp; &quot;selectioninfo,&quot; &amp; oCam &amp; &quot;sceneinfo&quot;, False
Else
	SetValue oCam &amp; &quot;refreshrate,&quot; &amp; oCam &amp; &quot;currenttime,&quot; &amp; oCam &amp; &quot;selectioninfo,&quot; &amp; oCam &amp; &quot;sceneinfo&quot;, True
