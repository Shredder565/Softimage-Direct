SPDL
Version = "2.0.0.0";
Reference = "{AB202601-FE3F-4269-AF90-A7DEE5E50F53}";
PropertySet "sib_incidence_v3_params"
{
	Parameter "out" output
	{
		title = "sib_incidence_v3 output parameter";
		guid = "{3BEF7B9D-2BC5-46DD-83F5-582DDAFE5B28}";
		type = scalar;
	}
	Parameter "mode" input
	{
		title = "mode";
		guid = "{5DD021CF-7F92-4C1F-9532-092D76A29B48}";
		type = integer;
		value = 6;
		texturable = on;
	}
	Parameter "bias" input
	{
		title = "incidence bias";
		guid = "{4A561CD8-BD14-425F-BB54-0E9F028D66AF}";
		type = scalar;
		value = 0.5;
		texturable = on;
	}
	Parameter "gain" input
	{
		title = "incidence gain";
		guid = "{DF8C9637-EE0D-470A-A765-D62AC6AE62A2}";
		type = scalar;
		value = 0.5;
		texturable = on;
	}
	Parameter "bump" input
	{
		title = "bump";
		guid = "{93C7A181-933C-41E9-81CC-EF5079E75B1E}";
		type = vector;
		value = 0.0 0.0 0.0;
		texturable = on;
	}
	Parameter "custom_vector" input
	{
		title = "custom vector";
		guid = "{501F540C-7D45-438E-B567-44E7DBB888A6}";
		type = vector;
		value = 0.0 1.0 0.0;
		texturable = on;
	}
	Parameter "invert" input
	{
		title = "invert incidence";
		guid = "{3893C4C9-F61A-4E25-BFE5-7242E8255E6E}";
		type = boolean;
		texturable = on;
	}
	Parameter "light_intensity" input
	{
		title = "incorporate light intensity";
		guid = "{B9705065-8961-41CC-85B5-1260C43E92AD}";
		type = boolean;
		value = true;
		texturable = on;
	}
	Parameter "normal_shading" input
	{
		title = "shading range";
		guid = "{354BE47A-86CF-4278-8691-15EBDD255179}";
		type = boolean;
		value = true;
		texturable = on;
	}
	Parameter "lights" input
	{
		title = "global light list";
		guid = "{78481893-8ECD-4A7F-A3B0-6CC05AEDAFC9}";
		texturable = off;
		inspectable = off;
		type = array
		{
			Parameter "lights" input
			{
				title = "global light list";
				guid = "{30401E9B-9852-4CD9-9FB7-69C3B5DB588C}";
