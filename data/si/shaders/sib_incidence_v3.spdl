		texturable = off;
		type = array
		{
			Parameter "customlights" input
			{
				title = "custom light list";
				guid = "{B1195968-A0C7-413D-8E55-76378869FECC}";
				texturable = off;
				type = light;
				ui "no label" = true;
			}
		};
	}
}
MetaShader "sib_incidence_v3_declare"
{
	Name = "Incidence2";
	Type = texture;
	Renderer "mental ray"
	{
		Name = "sib_incidence_v2";
		FileName = "sibase.{EXT}";
		Options
		{
			"version" = 2;
		}
	}
	Renderer "MetaSL"
	{
		Name = "msl_soft_incidence";
		FileName = "softimage.msl";
	}
}
HelpFile = "<FactoryPath>/Doc/<DocLangPref>/xsidocs.chm::/shaderpresets722.htm";
Defaults
{
	mode
	{
		Name = "Mode";
		Description = "incidence mode";
		Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		uitype = "combo";
		items
		{
			"Camera / Lights" = 11,
			"Camera / Lights (Light List)" = 10,
			"Surface / Lights" = 9,
			"Surface / Lights (Light List)" = 8,
			"Surface / Camera" = 6,
			"Surface / Vector" = 7,
			"+X Axis" = 0,
			"-X Axis" = 1,
			"+Y Axis" = 2,
			"-Y Axis" = 3,
			"+Z Axis" = 4,
			"-Z Axis" = 5,
		}
	}
	custom_vector
	{
		Name = "Vector";
		Description = "custom_vector";
		Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		UIType = "vector";
		uirange = 0 to 1 by 0.001;
	}
	bias
	{
		Name = "Bias";
		Description = "incidence bias";
		Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		uirange = 0 to 1 by 0.001;
	}
	gain
	{
		Name = "Gain";
		Description = "incidence gain";
		Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		uirange = 0 to 1 by 0.001;
	}
	invert
	{
		Name = "Invert";
		Description = "invert incidence";
		Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
	}
	light_intensity
	{
		Name = "Illuminance";
		Description = "incorporate light intensity";
		Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
	}
	normal_shading
	{
		Name = "Shading Range";
		Description = "shading range";
		Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		UIType = "combo";
		Items
		{
			"90-degree" = 1,
			"180-degree" = 0,
		}
	}
	customlights
	{
		Name = "Lights";
		Description = "custom light list";
		UIType = "LightListParamItem.LightListParamItem.1";
	}

}
Logic
{
	Sub mode_Onchanged()
		pset.custom_vector.show(pset.mode.value = 7)
		pset.customlights.show(pset.mode.value = 8 or pset.mode.value = 10)
		pset.light_intensity.show((pset.mode.value = 8 or pset.mode.value = 9 )  and pset.normal_shading.value = true)
		pset.normal_shading.show(pset.mode.value = 8 or pset.mode.value = 9 )
	End Sub

	Sub normal_shading_OnChanged()
		pset.light_intensity.show(true)
		pset.light_intensity.enable((pset.mode.value = 8 or pset.mode.value = 9 )  and pset.normal_shading.value = true)
	End Sub

	Sub onInit
		pset.custom_vector.enable(true)
		pset.customlights.enable(true)
		pset.light_intensity.enable(true)
		pset.normal_shading.enable(true)
		pset.custom_vector.show(true)
		pset.customlights.show(true)
		pset.light_intensity.show(true)
		pset.normal_shading.show(true)
		mode_onchanged()
		normal_shading_OnChanged()
	End Sub 
}
Layout "Default"
{
	Name;
	mode;
	custom_vector;
	customlights;
	normal_shading,aligncenter;
	light_intensity,aligncenter;
	Group "Modify"
	{
		invert,aligncenter;
		bias;
		gain;
	}
}
Layout "Rendertree"
{
	mode;
	custom_vector;
	normal_shading;
	light_intensity;
	invert;
	bias;
	gain;
	bump;
}
