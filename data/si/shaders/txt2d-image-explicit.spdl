SPDL
version = "2.0.0.0";
Reference = "{1C500B61-023C-11D3-8C03-00A0243E3672}";
	PropertySet "txt2d-image-explicit_params"
	{
		Parameter "out" output
		{
			title = "Image 2D";
			guid = "{4C6879FF-7EC8-11D0-8E3B-00A0C90640EC}";
			type = color;
		}
		Parameter "tex" input
		{
			title = "tex";
			guid = "{1C500B62-023C-11D3-8C03-00A0243E3672}";
			type = texture;
			flags  = 1;
			texturable = on;
			ui "main input" = true;
		}
		Parameter "tspace_id" input
		{
			title = "Texture Space";
			guid = "{1C500B63-023C-11D3-8C03-00A0243E3672}";
			ui "mapping" = "{B6531F00-412A-11D4-AE63-00A0C96E63E1}"; # GUID_3D_UVDEF_SELECT
			type = texturespace;
			value = 0;
			flags  = 1;
			texturable = off;
			animatable = off;
		}
		#--------- The following set of parameters cannot be set manually by users.
		#--------- Softimage will fill these values automatically based on the tspace_id
		#--------- To access this data in a custom shader, copy the ui mapping.
		#--- Parameters for implicit texture calculation
		Parameter "tsupp_invxform" input
		{
			title = "Texture Support Inverse Transform";
			guid = "{775ECDC0-4484-11D4-AE64-00A0C96E63E1}";
			ui "mapping" = "{B6531F01-412A-11D4-AE63-00A0C96E63E1}"; # GUID_3D_UVDEF_TEXSUPPORT_XFORM
			type = matrix;
			texturable = off;
			animatable = false;
			persistable = false;	# Data never saved: stored in Projection Definition
			inspectable = false;
		}
		Parameter "project" input
		{
			title = "Projection Method";
			guid = "{775ECDC1-4484-11D4-AE64-00A0C96E63E1}";
			ui "mapping" = "{B6531F02-412A-11D4-AE63-00A0C96E63E1}"; # GUID_3D_UVDEF_PROJECTION_METHOD
			type = integer;
			texturable = off;
			animatable = false;
			persistable = false;	# Data never saved: stored in Projection Definition
			inspectable = false;
		}
		Parameter "selspace" input
		{
			title = "Space Transformation";
			guid = "{775ECDC3-4484-11D4-AE64-00A0C96E63E1}";
			ui "mapping" = "{B6531F03-412A-11D4-AE63-00A0C96E63E1}"; # GUID_3D_UVDEF_SELSPACE
			type = integer;
			texturable = off;
			animatable = false;
			persistable = false;	# Data never saved: stored in Projection Definition
			inspectable = false;
		}
		Parameter "vertex" input
		{
			title = "Triangle Intersection";
			guid = "{775ECDC4-4484-11D4-AE64-00A0C96E63E1}";
			ui "mapping" = "{B6531F04-412A-11D4-AE63-00A0C96E63E1}"; # GUID_3D_UVDEF_VERTEX
			type = integer;
			texturable = off;
			animatable = false;
			persistable = false;	# Data never saved: stored in Projection Definition
			inspectable = false;
		}

		#--- Parameters for post-transformation of a uv datum
		Parameter "tproj_xform" input
		{
			title = "Texture Space Transform";
			guid = "{775ECDC5-4484-11D4-AE64-00A0C96E63E1}";
			ui "mapping" = "{B6531F05-412A-11D4-AE63-00A0C96E63E1}"; # GUID_3D_UVDEF_TEXPROJ_XFORM
			type = matrix;
			animatable = false;
			texturable = off;
			persistable = false;	# Data never saved: stored in Projection Definition
			inspectable = false;
		}
		Parameter "wrap_u" input
		{
			title = "wrap_u";
			guid = "{775ECDC6-4484-11D4-AE64-00A0C96E63E1}";
			ui "mapping"  = "{B6531F0C-412A-11D4-AE63-00A0C96E63E1}"; # GUID_3D_UVDEF_WRAP_U
			type = boolean;
			texturable = off;
			animatable = false;
			persistable = false;	# Data never saved: stored in Projection Definition
			inspectable = false;
		}
		Parameter "wrap_v" input
		{
			title = "wrap_v";
			guid = "{775ECDC7-4484-11D4-AE64-00A0C96E63E1}";
			ui "mapping"  = "{B6531F0D-412A-11D4-AE63-00A0C96E63E1}"; # GUID_3D_UVDEF_WRAP_V
			type = boolean;
			texturable = off;
			animatable = false;
			persistable = false;	# Data never saved: stored in Projection Definition
			inspectable = false;
		}
		Parameter "wrap_w" input
		{
			title = "wrap_w";
			guid = "{775ECDC8-4484-11D4-AE64-00A0C96E63E1}";
			ui "mapping"  = "{B6531F0E-412A-11D4-AE63-00A0C96E63E1}"; # GUID_3D_UVDEF_WRAP_W
			type = boolean;
			texturable = off;
			animatable = false;
			persistable = false;	# Data never saved: stored in Projection Definition
			inspectable = false;
		}
		Parameter "seam_u" input
		{
			title = "seam_u";
			guid = "{69772D60-4908-11D4-AE65-00A0C96E63E1}";
			ui "mapping"  = "{B6531F0F-412A-11D4-AE63-00A0C96E63E1}"; # GUID_3D_UVDEF_SEAM_U
			type = boolean;
			texturable = off;
			animatable = false;
			persistable = false;	# Data never saved: generated by the Projection Definition
			inspectable = false;
		}
		Parameter "seam_v" input
		{
			title = "seam_v";
			guid = "{43656B80-5795-11D4-AE68-00A0C96E63E1}";
			ui "mapping"  = "{FAD00380-5794-11D4-AE68-00A0C96E63E1}"; # GUID_3D_UVDEF_SEAM_V
			type = boolean;
			texturable = off;
			animatable = false;
			persistable = false;	# Data never saved: generated by the Projection Definition
			inspectable = false;
		}
		Parameter "texhomog" input # Are the uv coordinates homogeneous? (homogeneous coordinate stored in w)
		{
			title = "texthomog";
			guid = "{DFC95BC4-60D1-4A0B-BFFC-32C6A2618050}";
			ui "mapping"  = "{3458F753-D5D2-4B8C-80A9-802853ABEF57}"; # GUID_3D_MAPTO_HOMOGENEOUS_COORDS
			type = boolean;
			texturable = off;
			animatable = false;
			persistable = false;	# Data never saved: generated by the projection
			inspectable = false;
		}
		#--------- The previous set of parameters cannot be set manually by users.
		#--------- Softimage will fill these values automatically based on the tspace_id
		#--------- To use this data in another shader, copy the ui "mapping"s for each parameter.
		Parameter "project_old" input
		{
			title = "Projection Method";
			guid = "{1C500B64-023C-11D3-8C03-00A0243E3672}";
			ui "mapping" = "{C8E660C0-43E9-11D4-AE64-00A0C96E63E1}"; # GUID_3D_UVDEF_PROJECTION_METHOD_OLD
			type = integer;
			value = 0;
			flags  = 1;
			texturable = off;
			animatable = off;
			persistable = false; # This parameter is being obsoleted
			inspectable = false;
		}
		Parameter "selspace_old" input
		{
			title = "Space Transformation";
			guid = "{1C500B65-023C-11D3-8C03-00A0243E3672}";
			ui "mapping" = "{C8E660C3-43E9-11D4-AE64-00A0C96E63E1}"; # GUID_3D_UVDEF_SELSPACE_OLD
			type = integer;
			flags  = 1;
			value = 0;
			texturable = off;
			animatable = off;
			persistable = false; # This parameter is being obsoleted
			inspectable = false;
		}
		Parameter "vertex_old" input
		{
			title = "Triangle Intersection";
			guid = "{1C500B66-023C-11D3-8C03-00A0243E3672}";
			ui "mapping" = "{C8E660C1-43E9-11D4-AE64-00A0C96E63E1}"; # GUID_3D_UVDEF_VERTEX_OLD
			type = integer;
			flags  = 1;
			value = 0;
			texturable = off;
			animatable = off;
			persistable = false; # This parameter is being obsoleted
			inspectable = false;
		}
		Parameter "tspace_xform_old" input
		{
			title = "Texture Space Transform";
			guid = "{1C500B67-023C-11D3-8C03-00A0243E3672}";
			ui "mapping" = "{C8E660C2-43E9-11D4-AE64-00A0C96E63E1}";  # GUID_3D_UVDEF_TEXPROJ_XFORM_OLD
			type = matrix;
			texturable = off;
			animatable = off;
			persistable = false; # This parameter is being obsoleted
			inspectable = false;
		}
		Parameter "repeats" input
		{
			title = "Texture repeat factor (X,Y,Z)";
			guid = "{1C500B68-023C-11D3-8C03-00A0243E3672}";
			ui "mapping" = "{D1068847-73BF-45e8-B176-689C1738C924}";  # GUID_Texture_Repeats
			type = vector;
			value = 1.0 1.0 1.0;
			texturable = on;
		}
		Parameter "alt_x" input
		{
			title = "alt_x";
			guid = "{1C500B69-023C-11D3-8C03-00A0243E3672}";
			ui "mapping" = "{9F7FA903-FFA5-11D0-860D-00A0C91412D9}";  # GUID_Texture_U_Alternate
			type = boolean;
			value = off;
			texturable = on;
		}
		Parameter "alt_y" input
		{
			title = "alt_y";
			guid = "{1C500B6A-023C-11D3-8C03-00A0243E3672}";
			ui "mapping" = "{900FB907-FFA5-11D0-860D-00A0C91412D9}";  # GUID_Texture_V_Alternate
			type = boolean;
			value = off;
			texturable = on;
		}
		Parameter "alt_z" input
		{
			title = "alt_z";
			guid = "{1C500B6B-023C-11D3-8C03-00A0243E3672}";
			type = boolean;
			value = off;
			texturable = on;
		}
		Parameter "torus_x_old" input
		{
			title = "torus_x";
			guid = "{1C500B6C-023C-11D3-8C03-00A0243E3672}";
			ui "mapping" = "{D1D3B320-4C4E-11D4-AE65-00A0C96E63E1}"; # GUID_3D_UVDEF_WRAP_U_OLD
			type = boolean;
			value = off;
			texturable = off;
			persistable = false; # This parameter is being obsoleted
			inspectable = false;
		}
		Parameter "torus_y_old" input
		{
			title = "torus_y";
			guid = "{1C500B6D-023C-11D3-8C03-00A0243E3672}";
			ui "mapping" = "{D1D3B321-4C4E-11D4-AE65-00A0C96E63E1}"; # GUID_3D_UVDEF_WRAP_V_OLD
			type = boolean;
			value = off;
			texturable = off;
			persistable = false; # This parameter is being obsoleted
			inspectable = false;
		}
		Parameter "torus_z_old" input
		{
			title = "torus_z";
			guid = "{1C500B6E-023C-11D3-8C03-00A0243E3672}";
			ui "mapping" = "{D1D3B322-4C4E-11D4-AE65-00A0C96E63E1}"; # GUID_3D_UVDEF_WRAP_W_OLD
			type = boolean;
			value = off;
			texturable = off;
			persistable = false; # This parameter is being obsoleted
			inspectable = false;
		}
		Parameter "min" input
		{
			title = "min";
			guid = "{1C500B6F-023C-11D3-8C03-00A0243E3672}";
			type = vector;
			value = 0.0 0.0 0.0;
			texturable = on;
		}
		Parameter "max" input
		{
			title = "max";
			guid = "{1C500B70-023C-11D3-8C03-00A0243E3672}";
			type = vector;
			value = 1.0 1.0 1.0;
			texturable = on;
		}
		Parameter "step" input
		{
			title = "step";
			guid = "{7FB29C55-B4C6-11D3-B8F1-00E08100004B}";
			type = vector;
			flags  = 1;
			value = 0.001 0.001 0.001;
			texturable = on;
		}
		Parameter "factor" input
		{
			title = "factor";
			guid = "{7FB29C56-B4C6-11D3-B8F1-00E08100004B}";
			type = scalar;
			flags  = 1;
			value = 5.0;
			texturable = on;
		}
		Parameter "torus_u" input
		{
			title = "torus_u";
			guid = "{7FB29C58-B4C6-11D3-B8F1-00E08100004B}";
			type = boolean;
			flags  = 1;
			value = off;
			texturable = on;
		}
		Parameter "torus_v" input
		{
			title = "torus_v";
			guid = "{7FB29C59-B4C6-11D3-B8F1-00E08100004B}";
			type = boolean;
			flags  = 1;
			value = off;
			texturable = on;
		}
		Parameter "alpha" input
		{
			title = "alpha";
			guid = "{7FB29C5A-B4C6-11D3-B8F1-00E08100004B}";
			type = boolean;
			flags  = 1;
			value = off;
			texturable = on;
		}
		Parameter "bump_inuse" input
		{
			title = "bump_inuse";
			guid = "{7FB29C5B-B4C6-11D3-B8F1-00E08100004B}";
			type = boolean;
			flags  = 1;
			value = off;
			texturable = on;
		}
		Parameter "alpha_output" input
		{
			title = "alpha_output";
			guid = "{A702F6B7-8ABB-11D4-9335-00E0293D48C6}";
			ui "mapping" = "{454B8A16-47FA-4a23-8A71-11B45DE03D37}";  # GUID_Texture_CopyAlphaToRGB
			type = boolean;
			flags  = 1;
			value = off;
			texturable = on;
		}
		Parameter "alpha_factor" input
		{
			title = "alpha_factor";
			guid = "{A702F6B8-8ABB-11D4-9335-00E0293D48C6}";
			ui "mapping" = "{BC576C72-0F90-47e0-80A8-2E51EF46EEA8}";  # GUID_Texture_CopyAlphaToRGB_Factor
			type = scalar;
			flags  = 1;
			value = 1.0;
			texturable = on;
		}
		Parameter "eccmax" input
		{
			title = "eccmax";
			guid = "{44E30614-8EA6-11D4-9339-00E0293D48C6}";
			type = scalar;
			texturable = on;
			flags  = 1;
			value = 20.0;
		}
		Parameter "maxminor" input
		{
			title = "maxminor";
			guid = "{44E30615-8EA6-11D4-9339-00E0293D48C6}";
			type = scalar;
			texturable = on;
			flags  = 1;
			value = 16.0;
		}
		Parameter "disc_r" input
		{
			title = "disc_r";
			guid = "{44E30616-8EA6-11D4-9339-00E0293D48C6}";
			type = scalar;
			texturable = on;
			flags  = 1;
			value = 0.3;
		}
		Parameter "bilinear" input
		{
			title = "bilinear";
			guid = "{44E30617-8EA6-11D4-9339-00E0293D48C6}";
			type = boolean;
			texturable = on;
			flags  = 1;
			value = on;
		}
		Parameter "filtered" input
		{
			title = "filtered";
			guid = "{44E30618-8EA6-11d4-9339-00E0293D48C6}";
			type = boolean;
			texturable = on;
			flags  = 1;
			value = off;
		}
		Parameter "bump_filtered" input
		{
			title = "bump_filtered";
			guid = "{525E3313-EF25-11D5-86E9-00E08100004B}";
			type = boolean;
			texturable = on;
			flags  = 1;
			value = off;
		}
		Parameter "exposure" input
		{
			title = "exposure";
			guid = "{9AB5DB0E-57D6-4CF9-A8BE-591FAD59BFBE}";
			type = scalar;
			writable = off;
			inspectable = off;
			value = 0.0;
			ui "value mapping" = "tex.Exposure";
		}
		Parameter "gamma_enable" input
		{
			title = "gamma enable";
			guid = "{98559B4A-7C68-44F4-873C-702D62C8B3AB}";
			type = boolean;
			writable = off;
			inspectable = off;
			value = off;
			ui "value mapping" = "tex.RenderGammaEnable";
		}
		Parameter "gamma" input
		{
			title = "gamma";
			guid = "{272B9F5C-4C77-4653-97B3-C9005EC04DF9}";
			type = scalar;
			writable = off;
			inspectable = off;
			value = 1.0;
			ui "value mapping" = "tex.RenderGamma";
		}
		Parameter "srgb_enable" input
		{
			title = "srgb_enable";
			guid = "{3AE28DAE-7B67-4d22-AB83-3A64385AA892}";
			type = boolean;
			writable = off;
			inspectable = off;
			value = off;
			ui "value mapping" = "tex.RenderColorProfile_SRGB";
		}
	}
	
	MetaShader "txt2d-image-explicit_declare"
	{
		Name = "Image";
		Type = texture;
		Renderer "mental ray"
		{
			Name = "txt2d-image-explicit";
			Options
			{
				"version" = 2;
			}
			BeginText
			
			Node "state_tex"			= guid "{BDE291C7-077A-11D2-8A1A-00A0C9892542}"; # sib_state_vector.spdl
			Node "sibtexlook"			= guid "{580CCE23-E834-402A-A793-4B9C1CBDB963}"; # sib_texture_lookup
			Node "sibtexlook_bump"		= guid "{580CCE23-E834-402A-A793-4B9C1CBDB963}"; # sib_texture_lookup
			
			Node "uvwgen"				= guid "{C7A2CD40-4478-11D4-AE64-00A0C96E63E1}"; # sib_uvwgen
			Node "remap"				= guid "{4E57ACE4-B473-11D1-90E1-0000F804EB21}"; # mib_texture_remap
			Node "remap_bump"			= guid "{4E57ACE4-B473-11D1-90E1-0000F804EB21}"; # mib_texture_remap
			Node "basis"				= guid "{811FFAA5-2A42-47DF-B767-8DAEB5993E9C}"; # sib_bump_basis
			Node "bump"					= guid "{DA89443E-C521-4DD9-806D-90FA2806EDF8}"; # sib_bump_map
			Node "setnormal"			= guid "{2D8736C0-F37B-11D3-AE5B-00A0C96E63E1}"; # sib_setnormal
			Node "switch_alpha"			= guid "{85C16046-BCFA-11D1-90E9-0000F804EB21}"; # sib_color_switch
			Node "exposure"				= guid "{7C00BAE4-10B0-40A1-9805-9981E1232E59}"; # sib_color_exposure_gamma
			
			Node "color2alpha"			= guid "{523C43D8-B473-11D1-90E1-0000F804EB21}"; # mib_color_alpha
			
			#---- Texture space generator node.
			Connection "uvwgen::select"			= interface "tspace_id";
			Connection "uvwgen::selspace"		= interface "selspace";
			Connection "uvwgen::vertex"			= interface "vertex";
			Connection "uvwgen::project"		= interface "project";
			Connection "uvwgen::supp_invxform"	= interface "tsupp_invxform";
			Connection "uvwgen::seam_u"			= interface "seam_u";
			Connection "uvwgen::seam_v"			= interface "seam_v";
			Connection "uvwgen::texhomog"		= interface "texhomog";
			
			#---- Image remapping node.
			Connection "remap::input"		= value 0.0 0.0 0.0;  # Won't be used (shader_call_x)
			Connection "remap::alt_x"		= interface "alt_x";
			Connection "remap::alt_y"		= interface "alt_y";
			Connection "remap::alt_z"		= interface "alt_z";
			Connection "remap::torus_x"		= interface "wrap_u";
			Connection "remap::torus_y"		= interface "wrap_v";
			Connection "remap::torus_z"		= interface "wrap_w";
			Connection "remap::repeat"		= interface "repeats";
			Connection "remap::transform"	= interface "tproj_xform";
			Connection "remap::min"			= interface "min";
			Connection "remap::max"			= interface "max";
			
			#---- Image Lookup node
			Connection "sibtexlook::tex"		= interface "tex";
			Connection "sibtexlook::coord"		= "uvwgen";
			Connection "sibtexlook::clamp"		= value on;
			Connection "sibtexlook::remap"		= value "remap";
			Connection "sibtexlook::filtered"	= interface "filtered";
			Connection "sibtexlook::eccmax"		= interface "eccmax";
			Connection "sibtexlook::maxminor"	= interface "maxminor";
			Connection "sibtexlook::disc_r"		= interface "disc_r";
			Connection "sibtexlook::bilinear"	= interface "bilinear";
			Connection "sibtexlook::space"		= interface "tspace_id";
			
			#---- Bump map nodes
			Connection "remap_bump::input"			= value 0.0 0.0 0.0;  # Won't be used (shader_call_x)
			Connection "remap_bump::alt_x"			= interface "alt_x";
			Connection "remap_bump::alt_y"			= interface "alt_y";
			Connection "remap_bump::alt_z"			= interface "alt_z";
			Connection "remap_bump::torus_x"		= interface "wrap_u";
			Connection "remap_bump::torus_y"		= interface "wrap_v";
			Connection "remap_bump::torus_z"		= interface "wrap_w";
			Connection "remap_bump::repeat"			= interface "repeats";
			Connection "remap_bump::transform"		= interface "tproj_xform";
			Connection "remap_bump::min"			= interface "min";
			Connection "remap_bump::max"			= interface "max";
			
			Connection "state_tex::mode"			= value 6; # texture vector, so called state->tex
			
			Connection "sibtexlook_bump::tex"		= interface "tex";
			Connection "sibtexlook_bump::coord"		= "state_tex";
			Connection "sibtexlook_bump::remap"		= value "remap_bump";
			Connection "sibtexlook_bump::clamp"		= value on;
			Connection "sibtexlook_bump::filtered"	= interface "bump_filtered";
			Connection "sibtexlook_bump::eccmax"	= interface "eccmax";
			Connection "sibtexlook_bump::maxminor"	= interface "maxminor";
			Connection "sibtexlook_bump::disc_r"	= interface "disc_r";
			Connection "sibtexlook_bump::bilinear"	= interface "bilinear";
			Connection "sibtexlook_bump::space"		= interface "tspace_id";
			
			Connection "basis::ntex"				= interface "tspace_id";
			Connection "basis::project"				= interface "project";
			
			Connection "bump::coord"				= "uvwgen";
			Connection "bump::u"					= "basis::u";
			Connection "bump::v"					= "basis::v";
			Connection "bump::step"					= interface "step";
			Connection "bump::factor"				= interface "factor";
			Connection "bump::torus_u"				= interface "torus_u";
			Connection "bump::torus_v"				= interface "torus_v";
			Connection "bump::alpha"				= interface "alpha";
			Connection "bump::tex"					= value "sibtexlook_bump";
			Connection "bump::clamp"				= value off;
			
			#---- Add exposure/gamma
			Connection "exposure::input"			= "sibtexlook";
			Connection "exposure::exposure"			= interface "exposure";
			Connection "exposure::gamma_enable"		= interface "gamma_enable";
			Connection "exposure::gamma"			= interface "gamma";
			Connection "exposure::srgb_enable"		= interface "srgb_enable";

			#---- Use Alpha
			Connection "color2alpha::input"			= "exposure";
			Connection "color2alpha::factor"		= interface "alpha_factor";
			
			Connection "switch_alpha::input1"		= "exposure";
			Connection "switch_alpha::input2"		= "color2alpha";
			Connection "switch_alpha::switch"		= interface "alpha_output";
			
			#---- perturb surface normal (bumpmap)
			Connection "setnormal::input"			= "switch_alpha";
			Connection "setnormal::normal"			= "bump";
			Connection "setnormal::inuse"			= interface "bump_inuse";
			
			Connection root							= "setnormal";
			EndText
		}
		
		Renderer "MetaSL"
		{
			Name = "msl_soft_txt2d_imagev2";
			FileName = "softimage.msl";
			Options
			{
				// Implementation for the different Display Modes
				// Empty string will use the default symbol.
				// Put "ignore" if you want the shader to be skipped silently
				"hqv constant"			=  "ignore";
				"hqv shaded"			=  "ignore";
				"hqv textured"			=  "";
				"hqv texturedecal"		=  "";
				"hqv proc textured"		=  "";
				"hqv proc texturedecal"	=  "";
			}
		}
	}

BEGIN "{24810490-56FF-11d2-BF23-00A0C982CE5D}"
HelpFile = "<FactoryPath>/Doc/<DocLangPref>/xsidocs.chm::/shaderpresets32.htm";
	Defaults
	{
		tspace_id
		{
			Name = "Texture Projection";
			Description = "This parameter allows to select the source texture coordinates";
			UIType = "TextureSpaceItem.TextureSpaceItem.1";
			Items
			{
			}
		}
		tex
		{
			Name = "Texture Image";
			Description = "Texture Image used to map over object surface.";
			UIType = "ImageBrowserItem.ImageBrowserItem.1";
		}
		repeats
		{
			Name = "Texture repeats";
			Description = "Texture repeats set how many time the texture is repeated within the texture space defined.";
			UIType = "vector";
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
			UIRange = 0.0 to 10.0 by 0.001;
		}
		alt_x
		{
			Name = "U";
			Description = "Allow to Alternate texture on U, Visible only when repeat X is higher than 1.";
			UIType = "iconlist"
			{
			   nocol      = 2;
			   useselicon = True;
			}
			Items
			{
			   "bitmaps/alternatealloff.bmp" = 0,
			   "bitmaps/alternateuon.bmp" = 1,
			}

		}
		alt_y
		{
			Name = "V";
			Description = "Allow to Alternate texture on V, Visible only when repeat Y is higher than 1.";
			UIType = "iconlist"
			{
			   nocol      = 2;
			   useselicon = True;
			}
			Items
			{
			   "bitmaps/alternatealloff.bmp" = 0,
			   "bitmaps/alternatevon.bmp" = 1,
			}
		}
		alt_z
		{
			Name = "Z";
			Description = "Not used in this node. Allow to Alternate texture on Z, Visible only when repeat Z is higher than 1.";
		}
		min
		{
			Name = "Minimum";
			Description = "Allow to remap texture from lower/left corner, Z is ignored.";
			UIType = "vector";
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
			UIRange = 0.0 to 1.0 by 0.001;
		}
		max
		{
			Name = "Maximum";
			Description = "Allow to remap texture from top/right corner, Z is ignored.";
			UIType = "vector";
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
			UIRange = 0.0 to 1.0 by 0.001;
		}
		step
		{
			Name = "Step";
			Description = "Step.";
			UIType = "vector";
			Commands = "{F5C75F11-2F05-11D3-AA95-00AA0068D2C0}";
			UIRange = 0.0 to 0.01 by 0.0001;
		}
		factor
		{
			Name = "Factor";
			Description = "Bump Map Factor determine the height of the bump map.";
			UIRange = -20.0 to 20.0 by 0.0001;
			Commands = "{F5C75F11-2F05-11D3-AA95-00AA0068D2C0}";
			UIType = "Number"
			{
				SyncSlider = True;
				Decimals = 4;
			}
		}
		torus_u
		{
			Name = "Bumpmap Torus U";
			Description = "Torus U.";
		}
		torus_v
		{
			Name = "Bumpmap Torus V";
			Description = "Torus V.";
		}
		alpha
		{
			Name = "Use Alpha";
			Description = "Use Alpha for bump map.";
		}
		alpha_output
		{
			Name = "Enable";
			Description = "Output Alpha as color output";
		}
		alpha_factor
		{
			Name = "Alpha Strength";
			Description = "Set the alpha output strength";
			UIRange = 0.0 to 1.0 by 0.01;
			Commands = "{F5C75F11-2F05-11D3-AA95-00AA0068D2C0}";
		}
		bump_inuse
		{
			Name = "Enable";
			Description = "Enable Bump Mapping";
		}
		eccmax
		{
			Name = "Maximum eccentricity";
			Description = "Maximum eccentricity";
			UIRange = 0.0 to 20.0 by 0.01;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		maxminor
		{
			Name = "Maximum pixels for Min Radius";
			Description = "Maximum pixel for minimum radius";
			UIRange = 0.0 to 64.0 by 0.01;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		disc_r
		{
			Name = "Disc Radius";
			Description = "Disc Radius";
			UIRange = 0.0 to 0.3 by 0.01;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		bilinear
		{
			Name = "Bilinear Interpolation";
			Description = "Bilinear Interpolation";
		}
		filtered
		{
			Name = "RGBA";
			Description = "Enable elliptical filtering";
		}
		bump_filtered
		{
			Name = "Bump Mapping";
			Description = "Enable elliptical filtering for Bump Mapping";
		}
	}

	Logic
	{
		Sub bump_filtered_OnChanged()
				pset.eccmax.Enable(pset.filtered.value or pset.bump_filtered.value)
				pset.maxminor.Enable(pset.filtered.value or pset.bump_filtered.value)
				pset.disc_r.Enable(pset.filtered.value or pset.bump_filtered.value)
				pset.bilinear.Enable(pset.filtered.value or pset.bump_filtered.value)
		End Sub

		Sub filtered_OnChanged()
				pset.eccmax.Enable(pset.filtered.value or pset.bump_filtered.value)
				pset.maxminor.Enable(pset.filtered.value or pset.bump_filtered.value)
				pset.disc_r.Enable(pset.filtered.value or pset.bump_filtered.value)
				pset.bilinear.Enable(pset.filtered.value or pset.bump_filtered.value)
		End Sub

		Sub alpha_output_Onchanged()
			pset.alpha_factor.Enable(pset.alpha_output)
		End Sub

		Sub bump_inuse_Onchanged()
			pset.alpha.Enable(pset.bump_inuse)	
			pset.factor.Enable(pset.bump_inuse)
			pset.step.Enable(pset.bump_inuse)
		End Sub

		Sub Oninit
			' I really mean it.  Don't show this thing.
			tspace_xform_old.Show(false)
			tspace_xform_old.Enable(false)
			bump_inuse_Onchanged
			alpha_output_Onchanged
			filtered_OnChanged
			bump_filtered_OnChanged
		End Sub
	}

	Layout "Default"
	{
		Tab "Texture"
		{
			Name;
			Group "Image"
			{
				tex,NoLabel;
				Group "Copy Alpha to RGB"
				{
					alpha_output,AlignRight,30%,continue;
					alpha_factor;
				}
			}
			Group "Texture Projection"
			{
				tspace_id,NoLabel;
			}
			Group "Bump Mapping"
			{
				bump_inuse,aligncenter;
				alpha,aligncenter;
				factor,aligncenter;
				step,aligncenter;
			}
		}
		Tab "Image Filtering"
		{
			Name;
			Group "Elliptical Filtering"
			{
				Group "Apply to"
				{
					filtered,continue,aligncenter;
					bump_filtered,aligncenter;
				}
				eccmax;
				maxminor;
				disc_r;
				bilinear,AlignRight;
			}
		}
		Tab "Advanced"
		{
			Name;
			Group "Alternate"
			{
				alt_x,aligncenter;
				alt_y,aligncenter;
			}
			Group "Repeats"
			{
				repeats,aligncenter;
			}
			Group "UV Remap", 100%
			{
				min,aligncenter,continue;
				max,aligncenter;
			}
		}
	}

	Layout "X3D"
	{
		Group "Texture Image"
		{
			tex,NoLabel;
			Group "Copy Alpha to RGB"
			{
				alpha_output,AlignRight;
				alpha_factor;
			}
		}
		Group "Bump Mapping"
		{
			bump_inuse,aligncenter;
			alpha,aligncenter;
			factor,aligncenter;
			step,aligncenter;
		}
		Group "Alternate"
		{
			alt_x,aligncenter;
			alt_y,aligncenter;
		}
		Group "Repeats"
		{
			repeats,aligncenter;
		}
	}

	Layout "RenderTree"
	{
		tex;
		alpha_output;
		alpha_factor;
		Group "Image Filtering"
		{
			filtered;
			bump_filtered;
			eccmax;
			maxminor;
			disc_r;
			bilinear;
		}
		Group "Bump Mapping"
		{
			bump_inuse;
			alpha;
			factor;
			step;
		}
		Group "Remapping"
		{
			alt_x;
			alt_y;
			alt_z;
			torus_u;
			torus_v;
			torus_w;
			repeats;
			min;
			max;
		}
	}
	
	Shaderball
	{
		Dimension = Parametric;
		Show	  = false;
	}
	
END
