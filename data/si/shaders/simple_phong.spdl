	PropertySet "simple_phong_params"
	{
		Parameter "out" output
		{
			title = "Phong Shading";
			guid = "{4C6879FF-7EC8-11D0-8E3B-00A0C90640EC}";
			type = color;
		}
		Parameter "mode" input
		{
			title = "mode";
			guid = "{AFE986B0-2778-11D4-AE61-00A0C96E63E1}";
			type = integer;
			value = 0;
			flags  = 1;
			texturable = off;
			inspectable = off;
		}
		Parameter "lights" input
		{
			title = "Light List";
			guid = "{AFE986B1-2778-11D4-AE61-00A0C96E63E1}";
			texturable = off;
			type = array
			{
				Parameter "lights" input
				{
					title = "Light";
					guid = "{AFE986B2-2778-11D4-AE61-00A0C96E63E1}";
					texturable = off;
					type = light;
					flags  = 1;
				}
			};
		}
		Parameter "ambient" input
		{
			title = "Ambient";
			guid = "{AFE986B3-2778-11D4-AE61-00A0C96E63E1}";
			ui "mapping" = "{3515CC71-082C-11D0-91DE-00A024C78EE3}";
			type = color;
			value = 0.3 0.3 0.3;
			texturable = Default;
		}
		Parameter "diffuse" input
		{
			title = "Diffuse";
			guid = "{AFE986B4-2778-11D4-AE61-00A0C96E63E1}";
			ui "mapping" = "{3515CC72-082C-11D0-91DE-00A024C78EE3}";
			type = color;
			value = 0.7 0.7 0.7;
			texturable = Default;
		}
		Parameter "specular" input
		{
			title = "Specular";
			guid = "{AFE986B5-2778-11D4-AE61-00A0C96E63E1}";
			ui "mapping" = "{3515CC73-082C-11D0-91DE-00A024C78EE3}";
			type = color;
			value = 1.0 1.0 1.0;
			texturable = on;
		}
