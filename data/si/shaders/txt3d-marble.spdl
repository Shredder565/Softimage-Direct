	MetaShader "txt3d-marble_declare"
	{
		Name = "Marble";
		Type = texture;
		Renderer "mental ray"
		{
			Name = "txt3d-marble";
			Options
			{
				"version" = 1;
			}
			BeginText
			
			Node "marble"				= guid "{8C3F2750-BCFA-11D1-90E9-0000F804EB21}";
			Node "marble_bump"			= guid "{8C3F2750-BCFA-11D1-90E9-0000F804EB21}";
			Node "uvwgen"				= guid "{C7A2CD40-4478-11D4-AE64-00A0C96E63E1}"; # sib_uvwgen
			Node "remap"				= guid "{4E57ACE4-B473-11D1-90E1-0000F804EB21}"; # mib_texture_remap
			Node "remap_bump"			= guid "{4E57ACE4-B473-11D1-90E1-0000F804EB21}"; # mib_texture_remap
			Node "basis"				= guid "{811FFAA5-2A42-47DF-B767-8DAEB5993E9C}"; # sib_bump_basis
			Node "bump"					= guid "{DA89443E-C521-4DD9-806D-90FA2806EDF8}"; # sib_bump_map
			Node "setnormal"			= guid "{2D8736C0-F37B-11D3-AE5B-00A0C96E63E1}"; # sib_setnormal
			Node "state_tex"			= guid "{BDE291C7-077A-11D2-8A1A-00A0C9892542}";
			Node "switch"				= guid "{85C16046-BCFA-11D1-90E9-0000F804EB21}"; # sib_color_switch
			Node "color2alpha"			= guid "{523C43D8-B473-11D1-90E1-0000F804EB21}"; # mib_color_alpha
			
			#---- Texture space generator node.
			Connection "uvwgen::select"			= interface "tspace_id";
			Connection "uvwgen::selspace"		= interface "selspace";
			Connection "uvwgen::vertex"			= interface "vertex";
			Connection "uvwgen::project"		= interface "project";
			Connection "uvwgen::supp_invxform"	= interface "tsupp_invxform";
			Connection "uvwgen::seam_u"			= interface "seam_u";
			Connection "uvwgen::seam_v"			= interface "seam_v";
			Connection "uvwgen::texhomog"		= interface "texhomog";
			
			#---- Image remapping node.
			Connection "remap::input"		= "uvwgen";
			Connection "remap::alt_x"		= interface "alt_x";
			Connection "remap::alt_y"		= interface "alt_y";
			Connection "remap::alt_z"		= interface "alt_z";
			Connection "remap::torus_x"		= interface "wrap_u";
			Connection "remap::torus_y"		= interface "wrap_v";
			Connection "remap::torus_z"		= interface "wrap_w";
			Connection "remap::repeat"		= interface "repeats";
			Connection "remap::transform"	= interface "tproj_xform";
			Connection "remap::min"			= interface "min";
			Connection "remap::max"			= interface "max";
			
			Connection "marble::coord"			= "remap";
			Connection "marble::filler_col"		= interface "filler_col";
			Connection "marble::vein_col1"		= interface "vein_col1";
			Connection "marble::vein_col2"		= interface "vein_col2";
			Connection "marble::vein_width"		= interface "vein_width";
			Connection "marble::diffusion"		= interface "diffusion";
			Connection "marble::spot_color"		= interface "spot_color";
			Connection "marble::spot_bias"  	= interface "spot_bias";
			Connection "marble::spot_scale"		= interface "spot_scale";
			Connection "marble::spot_density" 	= interface "spot_density";
			Connection "marble::amplitude"		= interface "amplitude";
			Connection "marble::ratio"			= interface "ratio";
			Connection "marble::complexity"		= interface "complexity";
			Connection "marble::frequencies" 	= interface "frequencies";
			Connection "marble::absolute"		= interface "absolute";
			Connection "marble::noise_type"		= interface "noise_type";
			
			#---- Bumpmapping
			Connection "state_tex::mode"			= value 6; # return state->tex
			
			Connection "remap_bump::input"			= "state_tex";
			Connection "remap_bump::alt_x"			= interface "alt_x";
			Connection "remap_bump::alt_y"			= interface "alt_y";
			Connection "remap_bump::alt_z"			= interface "alt_z";
			Connection "remap_bump::torus_x"		= interface "wrap_u";
			Connection "remap_bump::torus_y"		= interface "wrap_v";
			Connection "remap_bump::torus_z"		= interface "wrap_w";
			Connection "remap_bump::repeat"			= interface "repeats";
			Connection "remap_bump::transform"		= interface "tproj_xform";
			Connection "remap_bump::min"			= interface "min";
			Connection "remap_bump::max"			= interface "max";
			
			Connection "marble_bump::coord"			= "remap_bump";
			Connection "marble_bump::filler_col"	= interface "filler_col";
			Connection "marble_bump::vein_col1"		= interface "vein_col1";
			Connection "marble_bump::vein_col2"		= interface "vein_col2";
			Connection "marble_bump::vein_width"	= interface "vein_width";
			Connection "marble_bump::diffusion"		= interface "diffusion";
			Connection "marble_bump::spot_color"	= interface "spot_color";
			Connection "marble_bump::spot_bias"  	= interface "spot_bias";
			Connection "marble_bump::spot_scale"	= interface "spot_scale";
			Connection "marble_bump::spot_density" 	= interface "spot_density";
			Connection "marble_bump::amplitude"		= interface "amplitude";
			Connection "marble_bump::ratio"			= interface "ratio";
			Connection "marble_bump::complexity"	= interface "complexity";
			Connection "marble_bump::frequencies"	= interface "frequencies";
			Connection "marble_bump::absolute"		= interface "absolute";
			Connection "marble_bump::noise_type"	= interface "noise_type";
			
			Connection "basis::ntex"				= interface "tspace_id";
			Connection "basis::project"				= interface "project";
			
			Connection "bump::coord"				= "uvwgen";
			Connection "bump::u"					= "basis::u";
			Connection "bump::v"					= "basis::v";
			Connection "bump::step"					= interface "step";
			Connection "bump::factor" 				= interface "factor";
			Connection "bump::torus_u"				= interface "torus_u";
			Connection "bump::torus_v"				= interface "torus_v";
			Connection "bump::alpha" 				= interface "alpha";
			Connection "bump::tex"					= value "marble_bump";
			Connection "bump::clamp"				= value off;
			
			Connection "color2alpha::input" 		= "marble";
			Connection "color2alpha::factor" 		= interface "alpha_factor";
			
			Connection "switch::input1"				= "marble";
			Connection "switch::input2"				= "color2alpha";
			Connection "switch::switch"				= interface "alpha_output";
			
			Connection "setnormal::input"			= "switch";
			Connection "setnormal::normal"			= "bump";
			Connection "setnormal::inuse"			= interface "bump_inuse";
			
			Connection root							= "setnormal";
			EndText
		}
		
		Renderer "MetaSL"
		{
			Name = "msl_soft_txt3d_marblev2";
			FileName = "softimage.msl";
		}
	}

BEGIN "{24810490-56FF-11d2-BF23-00A0C982CE5D}"
HelpFile = "<FactoryPath>/Doc/<DocLangPref>/xsidocs.chm::/shaderpresets110.htm";
	Defaults
	{
		filler_col
		{
			Name = "Filler";
			Description = "The colour of the filler material. This is the basic colour of the marble itself. RenderCost:1";
			UIType = "rgba",4;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		vein_col1
		{
			Name = "Vein 1";
			Description = "This defines the colour of the first vein material.  RenderCost:1";
			UIType = "rgba",4;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		vein_col2
		{
			Name = "Vein 2";
			Description = "This is the colour of the second of the alternating veins. Having this colour subtly different from the second can give convincing results. RenderCost:1";
			UIType = "rgba",4;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		vein_width
		{
			Name = "Width";
			Description = "The width of the veins in the marble. The lower the values the thinner the veins and the thicker the filler material and vice versa. RenderCost:1";
			UIRange = 0.0 to 1.0 by 0.01;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		diffusion
		{
			Name = "Diffusion";
			Description = "Controls how much the strongly pigmented vein material diffuses into the filler material. A very old marble typically has high diffusion. RenderCost:1";
			UIRange = 0.0 to 1.0 by 0.01;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		spot_color
		{
			Name = "Color";
			Description = "The colour of the impurities in the marble texture. RenderCost:1";
			UIType = "rgba",4;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		spot_bias
		{
			Name = "Bias";
			Description = "How much the spot contrasts to the marble itself is controlled using this parameter. RenderCost:1";
			UIRange = 0.0 to 1.0 by 0.01;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		spot_scale
		{
			Name = "Scale";
			Description = "The basic size of the impurities. Realistic effects are achieved when this value is small, say around 0.1. RenderCost:1";
			UIRange = 0.0 to 1.0 by 0.01;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		spot_density
		{
			Name = "Density";
			Description = "This parameter controls the spot density. RenderCost:1";
			UIRange = 0.0 to 1.0 by 0.01;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		amplitude
		{
			Name = "Amplitude";
			Description = "The base amplitude of the fractal. Note that this is only the amplitude of the first iteration and successive iterations may raise the local amplitude further. The fractal is used to distort the veins. RenderCost:1";
			UIRange = 0.0 to 5.0 by 0.01;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		ratio
		{
			Name = "Ratio";
			Description = "The amplitude of successive iterations relative to the current one. If it is less than one, successive iterations will have lower amplitude. If it is greater than one, they will have higher amplitude and the fractal will become unbounded. RenderCost:1";
			UIRange = 0.0 to 1.0 by 0.01;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		complexity
		{
			Name = "Complexity";
			Description = "The number of iterations used to generate the fractal. RenderCost:1";
			UIRange = 1.0 to 20.0 by 0.01;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		frequencies
		{
			Name = "Frequencies";
			Description = "The frequency of the fractal, in the X, Y and Z directions. RenderCost:1";
			UIType = "vector";
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
			UIRange = 0.0 to 1.0 by 0.001;
		}
		absolute
		{
			Name = "Absolute";
			Description = "Absolute. RenderCost:1";
		}
		tspace_id
		{
			Name = "Texture Space";
			Description = "Allows choosing the source space for projections. RenderCost:1";
			UIType = "TextureSpaceItem.TextureSpaceItem.1";
			Items
			{
			//	"Intersection" = -1,
			//	"Surface Orientation" = -2,
			//	"Motion" = -3,
			//	"Camera Orientation" = -4,
			//	"state->dPdu" = -5,
			//	"state->dPdv" = -6,
			//	"state->dPdudu" = -7,
			//	"state->dPdvdv" = -8,
			//	"state->dPdudv" = -9,
			//	"2D Background" = -10,
			}
		}
		repeats
		{
			Name = "Texture repeats";
			Description = "Texture repeats set how many time the texture is repeated within the texture space defined. RenderCost:1";
			UIType = "vector";
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
			UIRange = 0.0 to 10.0 by 0.001;
		}
		alt_x
		{
			Name = "U";
			Description = "Allow to Alternate texture on U, Visible only when repeat X is higher than 1. RenderCost:1";
		}
		alt_y
		{
			Name = "V";
			Description = "Allow to Alternate texture on V, Visible only when repeat Y is higher than 1. RenderCost:1";
		}
		alt_z
		{
			Name = "Z";
			Description = "Not used in this node. Allow to Alternate texture on Z, Visible only when repeat Z is higher than 1. RenderCost:1";
		}
		min
		{
			Name = "Minimum";
			Description = "Allow to remap texture from lower/left corner, Z is ignored. RenderCost:1";
			UIType = "vector";
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
			UIRange = 0.0 to 1.0 by 0.001;
		}
		max
		{
			Name = "Maximum";
			Description = "Allow to remap texture from top/right corner, Z is ignored. RenderCost:1";
			UIType = "vector";
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
			UIRange = 0.0 to 1.0 by 0.001;
		}
		step
		{
			Name = "Step";
			Description = "Step.";
			UIType = "vector";
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
			UIRange = 0.0 to 0.01 by 0.0001;
		}
		factor
		{
			Name = "Factor";
			Description = "Bump Map Factor determine the height of the bump map.";
			UIRange = -20.0 to 20.0 by 0.0001;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
			UIType = "Number"
			{
				SyncSlider = True;
				Decimals = 4;
			}
		}
		torus_u
		{
			Name = "Bumpmap Torus U";
			Description = "Torus U.";
		}
		torus_v
		{
			Name = "Bumpmap Torus V";
			Description = "Torus V.";
		}
		alpha
		{
			Name = "Use Alpha";
			Description = "Use Alpha for bump map.";
		}
		bump_inuse
		{
			Name = "Enable";
			Description = "Enable Bump Mapping";
		}
		alpha_output
		{
			Name = "Copy Alpha to RGB";
			Description = "Output Alpha as color output";
		}
		alpha_factor
		{
			Name = "Alpha Strength";
			Description = "Set the alpha output strength";
			UIRange = 0.0 to 1.0 by 0.01;
			Commands = "{F5C75F11-2F05-11D3-AA95-00AA0068D2C0}";
		}
		noise_type
		{
			Name = "Type";
			UIType = "combo";
			Items
			{
				"Legacy" = 0,
				"Default" = 1,
			}
		}
	}

	Logic
	{
		Sub bump_inuse_Onchanged()
			pset.alpha.Enable(pset.bump_inuse)	
			pset.factor.Enable(pset.bump_inuse)
			pset.step.Enable(pset.bump_inuse)
		End Sub

		Sub alpha_output_Onchanged()
			pset.alpha_factor.Enable(pset.alpha_output)
		End Sub

		Sub Oninit
			' I really mean it.  Don't show this thing.
			tspace_xform_old.Show(false)
			tspace_xform_old.Enable(false)
			bump_inuse_Onchanged
			alpha_output_Onchanged
		End Sub
	}

	Layout "Default"
	{
		Tab "Texture"
		{
			Name;
			tspace_id;
			Group "Bump Mapping"
			{
				bump_inuse,aligncenter;
				alpha,aligncenter;
				factor,aligncenter;
				step,aligncenter;
			}
		}
		Tab "Veins"
		{
				Name;
				vein_col1,aligncenter;
				vein_col2,aligncenter;
				filler_col,aligncenter;
				vein_width,aligncenter;
				diffusion,aligncenter;
				Group "Copy Alpha to RGB"
				{
					alpha_output,continue,nolabel,35%;
					alpha_factor,65%;
				}
		}
		Tab "Spots"
		{
				Name;
				spot_color;
				spot_density,aligncenter;
				spot_bias,aligncenter;
				spot_scale,aligncenter;
		}
		Tab "Fractal"
		{
			Name;
			noise_type;
			frequencies,aligncenter;
			amplitude,aligncenter;
			ratio,aligncenter;
			complexity,aligncenter;
			absolute;
		}
		Tab "Advanced"
		{
			Name;
			Group "Alternate", 100%
			{
				alt_x,aligncenter;
				alt_y,aligncenter;
				alt_z,aligncenter;
			}
			Group "Repeats"
			{
				repeats,aligncenter,nolabel;
			}
			Group "UV Remap", 100%
			{
				min,aligncenter,continue;
				max,aligncenter;
			}
		}
	}

	Layout "RenderTree"
	{
		Group "Veins"
		{
			vein_col1;
			vein_col2;
			filler_col;
			vein_width;
			diffusion;
			alpha_output;
			alpha_factor;
		}
		Group "Spots"
		{
			spot_color;
			spot_density;
			spot_bias;
			spot_scale;
		}
		Group "Fractal"
		{
			frequencies;
			amplitude;
			ratio;
			complexity;
			absolute;
		}
		Group "Bump Mapping"
		{
			bump_inuse;
			alpha;
			factor;
			step;
		}
		Group "Remapping"
		{
			alt_x;
			alt_y;
			alt_z;
			repeats;
			min;
			max;
		}
	}

	Shaderball
	{
		Dimension = Spatial;
		Show	  = true;
	}
	
END
