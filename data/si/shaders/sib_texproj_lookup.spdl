SPDL
version = "2.0.0.0";
Reference = "{4F13C237-8AB2-11D4-9335-00E0293D48C6}";
	PropertySet "sib_texproj_lookup_params"
	{
		Parameter "out" output
		{
			title = "Texture Generator";
			guid = "{1D58FA86-A96A-11D1-90DA-0000F804EB21}";
			type = vector;
		}
		Parameter "tspace_id" input
		{
			title = "Texture Space";
			guid = "{D550E9E3-8AB1-11D4-9335-00E0293D48C6}";
			ui "mapping" = "{B6531F00-412A-11D4-AE63-00A0C96E63E1}"; # GUID_3D_UVDEF_SELECT
			type = texturespace;
			value = 0;
			flags  = 1;
			texturable = off;
			animatable = off;
		}
		#--------- The following set of parameters cannot be set manually by users.
		#--------- Softimage will fill these values automatically based on the tspace_id
		#--------- To access this data in a custom shader, copy the ui mapping.
		#--- Parameters for implicit texture calculation
		Parameter "tsupp_invxform" input
		{
			title = "Texture Support Inverse Transform";
			guid = "{D550E9E4-8AB1-11D4-9335-00E0293D48C6}";
			ui "mapping" = "{B6531F01-412A-11D4-AE63-00A0C96E63E1}"; # GUID_3D_UVDEF_TEXSUPPORT_XFORM
			type = matrix;
			texturable = off;
			animatable = false;
			persistable = false;	# Data never saved: stored in Projection Definition
			inspectable = false;
		}
		Parameter "project" input
		{
			title = "Projection Method";
			guid = "{D550E9E5-8AB1-11D4-9335-00E0293D48C6}";
			ui "mapping" = "{B6531F02-412A-11D4-AE63-00A0C96E63E1}"; # GUID_3D_UVDEF_PROJECTION_METHOD
			type = integer;
			texturable = off;
			animatable = false;
			persistable = false;	# Data never saved: stored in Projection Definition
			inspectable = false;
		}
		Parameter "selspace" input
		{
			title = "Space Transformation";
			guid = "{D550E9E6-8AB1-11D4-9335-00E0293D48C6}";
			ui "mapping" = "{B6531F03-412A-11D4-AE63-00A0C96E63E1}"; # GUID_3D_UVDEF_SELSPACE
			type = integer;
			texturable = off;
			animatable = false;
			persistable = false;	# Data never saved: stored in Projection Definition
			inspectable = false;
		}
		Parameter "vertex" input
		{
			title = "Triangle Intersection";
			guid = "{D550E9E7-8AB1-11D4-9335-00E0293D48C6}";
			ui "mapping" = "{B6531F04-412A-11D4-AE63-00A0C96E63E1}"; # GUID_3D_UVDEF_VERTEX
			type = integer;
			texturable = off;
			animatable = false;
			persistable = false;	# Data never saved: stored in Projection Definition
			inspectable = false;
		}

		#--- Parameters for post-transformation of a uv datum
		Parameter "tproj_xform" input
		{
			title = "Texture Space Transform";
			guid = "{D550E9E8-8AB1-11D4-9335-00E0293D48C6}";
			ui "mapping" = "{B6531F05-412A-11D4-AE63-00A0C96E63E1}"; # GUID_3D_UVDEF_TEXPROJ_XFORM
			type = matrix;
			animatable = false;
			texturable = off;
			persistable = false;	# Data never saved: stored in Projection Definition
			inspectable = false;
		}
		Parameter "wrap_u" input
		{
			title = "wrap_u";
			guid = "{D550E9E9-8AB1-11D4-9335-00E0293D48C6}";
			ui "mapping"  = "{B6531F0C-412A-11D4-AE63-00A0C96E63E1}"; # GUID_3D_UVDEF_WRAP_U
			type = boolean;
			texturable = off;
			animatable = false;
			persistable = false;	# Data never saved: stored in Projection Definition
			inspectable = false;
		}
		Parameter "wrap_v" input
		{
			title = "wrap_v";
			guid = "{D550E9EA-8AB1-11D4-9335-00E0293D48C6}";
			ui "mapping"  = "{B6531F0D-412A-11D4-AE63-00A0C96E63E1}"; # GUID_3D_UVDEF_WRAP_V
			type = boolean;
			texturable = off;
			animatable = false;
			persistable = false;	# Data never saved: stored in Projection Definition
			inspectable = false;
		}
		Parameter "wrap_w" input
		{
			title = "wrap_w";
			guid = "{D550E9EB-8AB1-11D4-9335-00E0293D48C6}";
			ui "mapping"  = "{B6531F0E-412A-11D4-AE63-00A0C96E63E1}"; # GUID_3D_UVDEF_WRAP_W
			type = boolean;
			texturable = off;
			animatable = false;
			persistable = false;	# Data never saved: stored in Projection Definition
			inspectable = false;
		}
		Parameter "seam_u" input
		{
			title = "seam_u";
			guid = "{D550E9EC-8AB1-11D4-9335-00E0293D48C6}";
			ui "mapping"  = "{B6531F0F-412A-11D4-AE63-00A0C96E63E1}"; # GUID_3D_UVDEF_SEAM_U
			type = boolean;
			texturable = off;
			animatable = false;
			persistable = false;	# Data never saved: generated by the Projection Definition
			inspectable = false;
		}
		Parameter "seam_v" input
		{
			title = "seam_v";
			guid = "{D550E9ED-8AB1-11D4-9335-00E0293D48C6}";
			ui "mapping"  = "{FAD00380-5794-11D4-AE68-00A0C96E63E1}"; # GUID_3D_UVDEF_SEAM_V
			type = boolean;
			texturable = off;
			animatable = false;
			persistable = false;	# Data never saved: generated by the Projection Definition
			inspectable = false;
		}
		Parameter "texhomog" input # Are the uv coordinates homogeneous? (homogeneous coordinate stored in w, since we currently don't have 4d homogeneous)
		{
			title = "texthomog";
			guid = "{B89ACCD2-72CE-453B-9606-2DE5272C438C}";
			ui "mapping"  = "{3458F753-D5D2-4B8C-80A9-802853ABEF57}"; # GUID_3D_MAPTO_HOMOGENEOUS_COORDS
			type = boolean;
			texturable = off;
			animatable = false;
			persistable = false;	# Data never saved: generated by the projection
			inspectable = false;
		}
		Parameter "repeats" input
		{
			title = "Texture repeat factor (X,Y,Z)";
			guid = "{D550E9EE-8AB1-11D4-9335-00E0293D48C6}";
			type = vector;
			value = 1.0 1.0 1.0;
			texturable = on;
		}
		Parameter "alt_x" input
		{
			title = "alt_x";
			guid = "{D550E9EF-8AB1-11D4-9335-00E0293D48C6}";
			type = boolean;
			value = off;
			texturable = on;
		}
		Parameter "alt_y" input
		{
			title = "alt_y";
			guid = "{D550E9F0-8AB1-11D4-9335-00E0293D48C6}";
			type = boolean;
			value = off;
			texturable = on;
		}
		Parameter "alt_z" input
		{
			title = "alt_z";
			guid = "{D550E9F1-8AB1-11D4-9335-00E0293D48C6}";
			type = boolean;
			value = off;
			texturable = on;
		}
		Parameter "min" input
		{
			title = "min";
			guid = "{D550E9F2-8AB1-11D4-9335-00E0293D48C6}";
			type = vector;
			value = 0.0 0.0 0.0;
			texturable = on;
		}
		Parameter "max" input
		{
			title = "max";
			guid = "{D550E9F3-8AB1-11D4-9335-00E0293D48C6}";
			type = vector;
			value = 1.0 1.0 1.0;
			texturable = on;
		}
		Parameter "torus_u" input
		{
			title = "torus_u";
			guid = "{D550E9F4-8AB1-11D4-9335-00E0293D48C6}";
			type = boolean;
			flags  = 1;
			value = off;
			texturable = on;
		}
		Parameter "torus_v" input
		{
			title = "torus_v";
			guid = "{D550E9F5-8AB1-11D4-9335-00E0293D48C6}";
			type = boolean;
			flags  = 1;
			value = off;
			texturable = on;
		}
	}
	MetaShader "sib_texproj_lookup_declare"
	{
		Name = "Projection Lookup";
		Type = texture;
		Renderer "mental ray"
		{
			Name = "sib_texproj_lookup";
			Options
			{
				"version" = 1;
			}
			BeginText
			
			Node "uvwgen"			= guid "{C7A2CD40-4478-11D4-AE64-00A0C96E63E1}"; # sib_uvwgen
			Node "remap"			= guid "{4E57ACE4-B473-11D1-90E1-0000F804EB21}";
			
			#---- Texture space generator node.
			Connection "uvwgen::select"			= interface "tspace_id";
			Connection "uvwgen::selspace"		= interface "selspace";
			Connection "uvwgen::vertex"			= interface "vertex";
			Connection "uvwgen::project"		= interface "project";
			Connection "uvwgen::supp_invxform"	= interface "tsupp_invxform";
			Connection "uvwgen::seam_u"			= interface "seam_u";
			Connection "uvwgen::seam_v"			= interface "seam_v";
			Connection "uvwgen::texhomog"		= interface "texhomog";
			
			#---- Image remapping node.
			Connection "remap::input"		= "uvwgen";
			Connection "remap::alt_x"		= interface "alt_x";
			Connection "remap::alt_y"		= interface "alt_y";
			Connection "remap::alt_z"		= interface "alt_z";
			Connection "remap::torus_x"		= interface "wrap_u";
			Connection "remap::torus_y"		= interface "wrap_v";
			Connection "remap::torus_z"		= interface "wrap_w";
			Connection "remap::repeat"		= interface "repeats";
			Connection "remap::transform"	= interface "tproj_xform";
			Connection "remap::min"			= interface "min";
			Connection "remap::max"			= interface "max";
			
			Connection root				=	"remap";
			EndText
		}
		Renderer "MetaSL"
		{
			Name = "msl_soft_texproj_lookup";
			FileName = "softimage.msl";
		}
	}

BEGIN "{24810490-56FF-11d2-BF23-00A0C982CE5D}"
HelpFile = "<FactoryPath>/Doc/<DocLangPref>/xsidocs.chm::/shaderpresets686.htm";
	Defaults
	{
		tspace_id
		{
			Name = "Texture Projection";
			Description = "This parameter allows to select the source texture coordinates";
			UIType = "TextureSpaceItem.TextureSpaceItem.1";
			Items
			{
			}
		}
		repeats
		{
			Name = "Texture repeats";
			Description = "Texture repeats set how many time the texture is repeated within the texture space defined.";
			UIType = "vector";
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
			UIRange = 0.0 to 10.0 by 0.001;
		}
		alt_x
		{
			Name = "U";
			Description = "Allow to Alternate texture on U, Visible only when repeat X is higher than 1.";
		}
		alt_y
		{
			Name = "V";
			Description = "Allow to Alternate texture on V, Visible only when repeat Y is higher than 1.";
		}
		alt_z
		{
			Name = "Z";
			Description = "Not used in this node. Allow to Alternate texture on Z, Visible only when repeat Z is higher than 1.";
		}
		min
		{
			Name = "Minimum";
			Description = "Allow to remap texture from lower/left corner, Z is ignored.";
			UIType = "vector";
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
			UIRange = 0.0 to 1.0 by 0.001;
		}
		max
		{
			Name = "Maximum";
			Description = "Allow to remap texture from top/right corner, Z is ignored.";
			UIType = "vector";
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
			UIRange = 0.0 to 1.0 by 0.001;
		}
		torus_u
		{
			Name = "Bumpmap Torus U";
			Description = "Torus U.";
		}
		torus_v
		{
			Name = "Bumpmap Torus V";
			Description = "Torus V.";
		}
	}

	Layout "Default"
	{
		Tab "Texture Generator"
		{
			Name;
			tspace_id;
			Group "Repeats"
			{
				repeats,aligncenter;
			}
			Group "Alternate"
			{
				alt_x,aligncenter;
				alt_y,aligncenter;
				alt_z,aligncenter;
			}
			Group "UV Remap"
			{
				min,aligncenter;
				max,aligncenter;
			}
		}
	}
END
