			guid = "{2D66A8DF-ED68-11D2-843E-00E08100004E}";
			ui "mapping" = "{C8E660C3-43E9-11D4-AE64-00A0C96E63E1}"; # GUID_3D_UVDEF_SELSPACE_OLD
			type = integer;
