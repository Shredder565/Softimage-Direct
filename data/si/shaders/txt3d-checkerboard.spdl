SPDL
version = "2.0.0.0";
Reference = "{2D66A8D7-ED68-11D2-843E-00E08100004E}";
	PropertySet "txt3d-checkerboard_params"
	{
		Parameter "out" output
		{
			title = "Checkerboard";
			guid = "{4C6879FF-7EC8-11D0-8E3B-00A0C90640EC}";
			type = color;
		}
		Parameter "color1" input
		{
			title = "Color 1";
			guid = "{2D66A8D8-ED68-11D2-843E-00E08100004E}";
			type = color;
			value = 0.0 0.0 0.0 1.0;
			texturable = on;
		}
		Parameter "color2" input
		{
			title = "Color 2";
			guid = "{2D66A8D9-ED68-11D2-843E-00E08100004E}";
			type = color;
			value = 1.0 1.0 1.0 1.0;
			texturable = on;
		}
		Parameter "xsize" input
		{
			title = "Xsize";
			guid = "{2D66A8DA-ED68-11D2-843E-00E08100004E}";
			type = scalar;
			texturable = on;
			value = 0.5;
			flags  = 1;
		}
		Parameter "ysize" input
		{
			title = "Ysize";
			guid = "{2D66A8DB-ED68-11D2-843E-00E08100004E}";
			type = scalar;
			texturable = on;
			value = 0.5;
			flags  = 1;
		}
		Parameter "zsize" input
		{
			title = "Zsize";
			guid = "{2D66A8DC-ED68-11D2-843E-00E08100004E}";
			type = scalar;
			texturable = on;
			value = 0.5;
			flags  = 1;
		}
		Parameter "tspace_id" input
		{
			title = "Texture Space";
			guid = "{2D66A8DD-ED68-11D2-843E-00E08100004E}";
			ui "mapping" = "{B6531F00-412A-11D4-AE63-00A0C96E63E1}"; # GUID_3D_UVDEF_SELECT
			type = texturespace;
			value = -1;
			flags  = 1;
			texturable = off;
			animatable = off;
		}

		#--------- The following set of parameters cannot be set manually by users.
		#--------- Softimage will fill these values automatically based on the tspace_id
		#--------- To access this data in a custom shader, copy the ui mapping.
		#--- Parameters for implicit texture calculation
		Parameter "tsupp_invxform" input
		{
			title = "Texture Support Inverse Transform";
			guid = "{617C8A20-4C6E-11D4-B4DB-00D0B7142C4C}";
			ui "mapping" = "{B6531F01-412A-11D4-AE63-00A0C96E63E1}"; # GUID_3D_UVDEF_TEXSUPPORT_XFORM
			type = matrix;
			texturable = off;
			animatable = false;
			persistable = false;	# Data never saved: stored in Projection Definition
			inspectable = false;
		}
		Parameter "project" input
		{
			title = "Projection Method";
			guid = "{617C8A21-4C6E-11D4-B4DB-00D0B7142C4C}";
			ui "mapping" = "{B6531F02-412A-11D4-AE63-00A0C96E63E1}"; # GUID_3D_UVDEF_PROJECTION_METHOD
			type = integer;
			texturable = off;
			animatable = false;
			persistable = false;	# Data never saved: stored in Projection Definition
			inspectable = false;
		}
		Parameter "selspace" input
		{
			title = "Space Transformation";
			guid = "{617C8A22-4C6E-11D4-B4DB-00D0B7142C4C}";
			ui "mapping" = "{B6531F03-412A-11D4-AE63-00A0C96E63E1}"; # GUID_3D_UVDEF_SELSPACE
			type = integer;
			texturable = off;
			animatable = false;
			persistable = false;	# Data never saved: stored in Projection Definition
			inspectable = false;
		}
		Parameter "vertex" input
		{
			title = "Triangle Intersection";
			guid = "{617C8A23-4C6E-11D4-B4DB-00D0B7142C4C}";
			ui "mapping" = "{B6531F04-412A-11D4-AE63-00A0C96E63E1}"; # GUID_3D_UVDEF_VERTEX
			type = integer;
			texturable = off;
			animatable = false;
			persistable = false;	# Data never saved: stored in Projection Definition
			inspectable = false;
		}

		#--- Parameters for post-transformation of a uv datum
		Parameter "tproj_xform" input
		{
			title = "Texture Space Transform";
			guid = "{617C8A24-4C6E-11D4-B4DB-00D0B7142C4C}";
			ui "mapping" = "{B6531F05-412A-11D4-AE63-00A0C96E63E1}"; # GUID_3D_UVDEF_TEXPROJ_XFORM
			type = matrix;
			texturable = off;
			animatable = false;
			persistable = false;	# Data never saved: stored in Projection Definition
			inspectable = false;
		}
		Parameter "wrap_u" input
		{
			title = "wrap_u";
			guid = "{617C8A25-4C6E-11D4-B4DB-00D0B7142C4C}";
			ui "mapping"  = "{B6531F0C-412A-11D4-AE63-00A0C96E63E1}"; # GUID_3D_UVDEF_WRAP_U
			type = boolean;
			animatable = false;
			texturable = off;
			persistable = false;	# Data never saved: stored in Projection Definition
			inspectable = false;
		}
		Parameter "wrap_v" input
		{
			title = "wrap_v";
			guid = "{617C8A26-4C6E-11D4-B4DB-00D0B7142C4C}";
			ui "mapping"  = "{B6531F0D-412A-11D4-AE63-00A0C96E63E1}"; # GUID_3D_UVDEF_WRAP_V
			type = boolean;
			texturable = off;
			animatable = false;
			persistable = false;	# Data never saved: stored in Projection Definition
			inspectable = false;
		}
		Parameter "wrap_w" input
		{
			title = "wrap_w";
			guid = "{617C8A27-4C6E-11D4-B4DB-00D0B7142C4C}";
			ui "mapping"  = "{B6531F0E-412A-11D4-AE63-00A0C96E63E1}"; # GUID_3D_UVDEF_WRAP_W
			type = boolean;
			texturable = off;
			animatable = false;
			persistable = false;	# Data never saved: stored in Projection Definition
			inspectable = false;
		}
		Parameter "seam_u" input
		{
			title = "seam_u";
			guid = "{617C8A28-4C6E-11D4-B4DB-00D0B7142C4C}";
			ui "mapping"  = "{B6531F0F-412A-11D4-AE63-00A0C96E63E1}"; # GUID_3D_UVDEF_SEAM_U
			type = boolean;
			animatable = false;
			texturable = off;
			persistable = false;	# Data never saved: stored in Projection Definition
			inspectable = false;
		}
		Parameter "seam_v" input
		{
			title = "seam_v";
			guid = "{43656B88-5795-11D4-AE68-00A0C96E63E1}";
			ui "mapping"  = "{FAD00380-5794-11D4-AE68-00A0C96E63E1}"; # GUID_3D_UVDEF_SEAM_V
			type = boolean;
			texturable = off;
			animatable = false;
			persistable = false;	# Data never saved: generated by the Projection Definition
			inspectable = false;
		}
		Parameter "texhomog" input # Are the uv coordinates homogeneous? (homogeneous coordinate stored in w, since we currently don't have 4d homogeneous)
		{
			title = "texthomog";
			guid = "{CCA34ECC-357E-479E-B3AF-A98EEE230A0D}";
			ui "mapping"  = "{3458F753-D5D2-4B8C-80A9-802853ABEF57}"; # GUID_3D_MAPTO_HOMOGENEOUS_COORDS
			type = boolean;
			texturable = off;
			animatable = false;
			persistable = false;	# Data never saved: generated by the projection
			inspectable = false;
		}

		#--------- The previous set of parameters cannot be set manually by users.
		#--------- Softimage will fill these values automatically based on the tspace_id
		#--------- To use this data in another shader, copy the ui "mapping"s for each parameter.

		Parameter "project_old" input
		{
			title = "Projection Method";
			guid = "{2D66A8DE-ED68-11D2-843E-00E08100004E}";
			ui "mapping" = "{C8E660C0-43E9-11D4-AE64-00A0C96E63E1}"; # GUID_3D_UVDEF_PROJECTION_METHOD_OLD
