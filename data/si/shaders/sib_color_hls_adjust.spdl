Layout "Default"
{
	color;
	Tab "Master"
	{
		master_h;
		master_l;
		master_s;
	}
	Tab "RGB"
	{
		Group "Red"
		{
			red_h;
			red_l;
			red_s;
		}
		Group "Green"
		{
			green_h;
			green_l;
			green_s;
		}
		Group "Blue"
		{
			blue_h;
			blue_l;
			blue_s;
		}
	}
	Tab "CYM"
	{
		Group "Cyan"
