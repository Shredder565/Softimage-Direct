MetaShader "sib_color_hls_adjust_declare"
{
	Name = "Color HLS Adjust";
	Type = texture;
	Renderer "mental ray"
	{
		Name = "sib_color_hls_adjust";
		FileName = "sibase.{EXT}";
		Options
		{
			"version" = 1;
		}
	}
	
	Renderer "MetaSL"
	{
		Name = "msl_soft_hls_adjust";
		FileName = "softimage.msl";
	}	
	
}
