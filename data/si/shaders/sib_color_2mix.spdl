	PropertySet "sib_color_2mix_params"
	{
		Parameter "out" output
		{
			title = "Blend 2 Colors";
			guid = "{4C6879FF-7EC8-11D0-8E3B-00A0C90640EC}";
			type = color;
			flags  = 1;
		}

		Parameter "mixersize" input
		{
			title = "Number of inputs";
			guid = "{C99D3611-9D58-11D3-AE50-00A0C96E63E1}";
			type = integer;
			flags = 1;
			value = 2;
			texturable = off;
		}

		Parameter "base_color" input
		{
			title = "Base Color";
			guid = "{C99D3612-9D58-11D3-AE50-00A0C96E63E1}";
			type = color;
			flags  = 1;
			value = 0.0 1.0 0.0;
			texturable = on;
		}

#####################################
#COLOR1
		Parameter "color1" input
