	MetaShader "txt3d-wood_declare"
	{
		Name = "Wood";
		Type = texture;
		Renderer "mental ray"
		{
			Name = "txt3d-wood";
			Options
			{
				"version" = 1;
			}
			BeginText
			
			Node "wood"					= guid "{8DA5F939-BCFA-11D1-90E9-0000F804EB21}";
			Node "wood_bump"			= guid "{8DA5F939-BCFA-11D1-90E9-0000F804EB21}";
			Node "uvwgen"				= guid "{C7A2CD40-4478-11D4-AE64-00A0C96E63E1}"; # sib_uvwgen
			Node "remap"				= guid "{4E57ACE4-B473-11D1-90E1-0000F804EB21}"; # mib_texture_remap
			Node "remap_bump"			= guid "{4E57ACE4-B473-11D1-90E1-0000F804EB21}"; # mib_texture_remap
			Node "basis"				= guid "{811FFAA5-2A42-47DF-B767-8DAEB5993E9C}"; # sib_bump_basis
			Node "bump"					= guid "{DA89443E-C521-4DD9-806D-90FA2806EDF8}"; # sib_bump_map
			Node "setnormal"			= guid "{2D8736C0-F37B-11D3-AE5B-00A0C96E63E1}"; # sib_setnormal
			Node "state_tex"			= guid "{BDE291C7-077A-11D2-8A1A-00A0C9892542}";
			Node "switch"				= guid "{85C16046-BCFA-11D1-90E9-0000F804EB21}"; # sib_color_switch
			Node "color2alpha"			= guid "{523C43D8-B473-11D1-90E1-0000F804EB21}"; # mib_color_alpha
			
			#---- Texture space generator node.
			Connection "uvwgen::select"			= interface "tspace_id";
			Connection "uvwgen::selspace"		= interface "selspace";
			Connection "uvwgen::vertex"			= interface "vertex";
			Connection "uvwgen::project"		= interface "project";
			Connection "uvwgen::supp_invxform"	= interface "tsupp_invxform";
			Connection "uvwgen::seam_u"			= interface "seam_u";
			Connection "uvwgen::seam_v"			= interface "seam_v";
			Connection "uvwgen::texhomog"		= interface "texhomog";
			
			#---- Image remapping node.
			Connection "remap::input"		= "uvwgen";
			Connection "remap::alt_x"		= interface "alt_x";
			Connection "remap::alt_y"		= interface "alt_y";
			Connection "remap::alt_z"		= interface "alt_z";
			Connection "remap::torus_x"		= interface "wrap_u";
			Connection "remap::torus_y"		= interface "wrap_v";
			Connection "remap::torus_z"		= interface "wrap_w";
			Connection "remap::repeat"		= interface "repeats";
			Connection "remap::transform"	= interface "tproj_xform";
			Connection "remap::min"			= interface "min";
			Connection "remap::max"			= interface "max";
			
			Connection "wood::coord"			= "remap";
			Connection "wood::filler_col"		= interface "filler_col";
			Connection "wood::vein_col"			= interface "vein_col";
			Connection "wood::vein_spread"		= interface "vein_spread";
			Connection "wood::layer_size"		= interface "layer_size";
			Connection "wood::randomness"		= interface "randomness";
			Connection "wood::age"				= interface "age";
			Connection "wood::grain_col"		= interface "grain_col";
			Connection "wood::grain_bias"		= interface "grain_bias";
			Connection "wood::grain_scale"		= interface "grain_scale";
			Connection "wood::grain_density" 	= interface "grain_density";
			Connection "wood::center_u"			= interface "center_u";
			Connection "wood::center_v"			= interface "center_v";
			Connection "wood::wobbly_struct" 	= interface "wobbly_struct";
			Connection "wood::uamplitude"		= interface "uamplitude";
			Connection "wood::vamplitude"		= interface "vamplitude";
			Connection "wood::ratio"			= interface "ratio";
			Connection "wood::complexity"		= interface "complexity";
			Connection "wood::frequencies"		= interface "frequencies";
			Connection "wood::absolute"			= interface "absolute";
			Connection "wood::noise_type"		= interface "noise_type";
			
			#---- Bumpmapping
			Connection "state_tex::mode"		= value 6; # return state->tex
			
			Connection "remap_bump::input"		= "state_tex";
			Connection "remap_bump::alt_x"		= interface "alt_x";
			Connection "remap_bump::alt_y"		= interface "alt_y";
			Connection "remap_bump::alt_z"		= interface "alt_z";
			Connection "remap_bump::torus_x"	= interface "wrap_u";
			Connection "remap_bump::torus_y"	= interface "wrap_v";
			Connection "remap_bump::torus_z"	= interface "wrap_w";
			Connection "remap_bump::repeat"		= interface "repeats";
			Connection "remap_bump::transform"	= interface "tproj_xform";
			Connection "remap_bump::min"		= interface "min";
			Connection "remap_bump::max"		= interface "max";
			
			Connection "wood_bump::coord"			= "remap_bump";
			Connection "wood_bump::filler_col"		= interface "filler_col";
			Connection "wood_bump::vein_col"		= interface "vein_col";
			Connection "wood_bump::vein_spread"		= interface "vein_spread";
			Connection "wood_bump::layer_size"		= interface "layer_size";
			Connection "wood_bump::randomness"		= interface "randomness";
			Connection "wood_bump::age"				= interface "age";
			Connection "wood_bump::grain_col"		= interface "grain_col";
			Connection "wood_bump::grain_bias"		= interface "grain_bias";
			Connection "wood_bump::grain_scale"		= interface "grain_scale";
			Connection "wood_bump::grain_density"	= interface "grain_density";
			Connection "wood_bump::center_u"		= interface "center_u";
			Connection "wood_bump::center_v"		= interface "center_v";
			Connection "wood_bump::wobbly_struct"	= interface "wobbly_struct";
			Connection "wood_bump::uamplitude"		= interface "uamplitude";
			Connection "wood_bump::vamplitude"		= interface "vamplitude";
			Connection "wood_bump::ratio"			= interface "ratio";
			Connection "wood_bump::complexity"		= interface "complexity";
			Connection "wood_bump::frequencies"		= interface "frequencies";
			Connection "wood_bump::absolute"		= interface "absolute";
			Connection "wood_bump::noise_type"		= interface "noise_type";
			
			Connection "basis::ntex"			= interface "tspace_id";
			Connection "basis::project"			= interface "project";
			
			Connection "bump::coord"			= "uvwgen";
			Connection "bump::u"				= "basis::u";
			Connection "bump::v"				= "basis::v";
			Connection "bump::step"				= interface "step";
			Connection "bump::factor" 			= interface "factor";
			Connection "bump::torus_u"			= interface "torus_u";
			Connection "bump::torus_v"			= interface "torus_v";
			Connection "bump::alpha" 		 	= interface "alpha";
			Connection "bump::tex"				= value "wood_bump";
			Connection "bump::clamp"			= value off;
			
			Connection "color2alpha::input"			= "wood";
			Connection "color2alpha::factor"		= interface "alpha_factor";
			
			Connection "switch::input1"				= "wood";
			Connection "switch::input2"				= "color2alpha";
			Connection "switch::switch"				= interface "alpha_output";
			
			Connection "setnormal::input"			= "switch";
			Connection "setnormal::normal"			= "bump";
			Connection "setnormal::inuse"			= interface "bump_inuse";
			
			Connection root							= "setnormal";
			EndText
		}
		Renderer "MetaSL"
		{
			Name = "msl_soft_txt3d_woodv2";
			FileName = "softimage.msl";
		}
	}

BEGIN "{24810490-56FF-11d2-BF23-00A0C982CE5D}"
HelpFile = "<FactoryPath>/Doc/<DocLangPref>/xsidocs.chm::/shaderpresets101.htm";
	Defaults
	{
		filler_col
		{
			Name = "Filler";
			Description = "This controls the colour of the filler portion which in turn fades into the vein portion of the layer. RenderCost:1";
			UIType = "rgba",4;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		vein_col
		{
			Name = "Vein";
			Description = "The colour of the vein portion. RenderCost:1";
			UIType = "rgba",4;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		vein_spread
		{
			Name = "Vein Spread";
			Description = "This parameter defines how much the 'Vein' colour spreads into the 'Filler' colour in the layer. RenderCost:1";
			UIRange = 0.0 to 3.0 by 0.01;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		layer_size
		{
			Name = "Size";
			Description = "The size of a layer on a scale from zero to one. Actually this is the maximum size of the layers as the 'younger' layers are actually thinner than this. RenderCost:1";
			UIRange = 0.0 to 1.0 by 0.01;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		randomness
		{
			Name = "Random";
			Description = "Not all layers are created equal. This is determined by weather conditions and the nourishment the tree gets in the nature. This parameter affects how much variation there is in the size of the layers. RenderCost:1";
			UIRange = 0.0 to 1.0 by 0.01;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		age
		{
			Name = "Age";
			Description = "The age of the wood is controlled by this parameter. This controls how many layers it takes to reach the full layer size defined in 'Layer Size'. RenderCost:1";
			UIRange = 0.0 to 50.0 by 0.01;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		grain_col
		{
			Name = "Color";
			Description = "The colour of the wood grain. RenderCost:1";
			UIType = "rgba",4;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		grain_bias
		{
			Name = "Bias";
			Description = "Control how much contrast is between the colour of the grain and the wood colours. RenderCost:1";
			UIRange = 0.0 to 1.0 by 0.01;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		grain_scale
		{
			Name = "Size";
			Description = "The size of the grains in the wood. RenderCost:1";
			UIRange = 0.0 to 1.0 by 0.01;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		grain_density
		{
			Name = "Density";
			Description = "The density of the grains in the wood. If the 'Grain Bias' is set to 1.0 then a value of 1.0 in 'Grain Density' results in the wood being completely covered with grains. RenderCost:1";
			UIRange = 0.0 to 1.0 by 0.01;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		center_u
		{
			Name = "U";
			Description = "Center U, These parameter control where the layers originate from. RenderCost:1";
			UIRange = -5.0 to 5.0 by 0.01;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		center_v
		{
			Name = "V";
			Description = "Center V, These parameter control where the layers originate from. RenderCost:1";
			UIRange = -5.0 to 5.0 by 0.01;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		wobbly_struct
		{
			Name = "Wobbly Struct";
			Description = "If this item is ticked then the wood becomes a little deformed and is no longer contained in a unit square. Sort of like melted wood. The fractal amplitude must be non-zero for this parameter to have any effect.  RenderCost:2";
		}
		uamplitude
		{
			Name = "U Amp";
			Description = "U Amplitude, The base amplitude of the fractal. Note that this is only the amplitude of the first iteration and successive iterations may raise the local amplitude further. The fractal is used to distort the texture lookup, creating a wobbly looking wood. RenderCost:1";
			UIRange = 0.0 to 5.0 by 0.01;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		vamplitude
		{
			Name = "V Amp";
			Description = "V Amplitude, The base amplitude of the fractal. Note that this is only the amplitude of the first iteration and successive iterations may raise the local amplitude further. The fractal is used to distort the texture lookup, creating a wobbly looking wood. RenderCost:1";
			UIRange = 0.0 to 5.0 by 0.01;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		ratio
		{
			Name = "Ratio";
			Description = "The proportionality constant between the amplitude of successive iterations. If it is less than one, successive iterations will have lower amplitude. If it is greater than one, they will have higher amplitude and the fractal will become unbounded. RenderCost:1";
			UIRange = 0.0 to 1.0 by 0.01;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		complexity
		{
			Name = "Complexity";
			Description = "The number of iterations used to generate the fractal. RenderCost:2";
			UIRange = 0.0 to 20.0 by 0.01;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		frequencies
		{
			Name = "Freq";
			Description = "The frequency of the fractal, in the X, Y and Z directions. RenderCost:1";
			UIType = "vector";
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
			uirange = 0 to 20 by 0.001;
		}
		absolute
		{
			Name = "Absolute";
			Description = "Absolute. RenderCost:1";
		}
		tspace_id
		{
			Name = "Texture Space";
			Description = "Allows choosing the source space for projections. RenderCost:1";
			UIType = "TextureSpaceItem.TextureSpaceItem.1";
			Items
			{
			//	"Intersection" = -1,
			//	"Surface Orientation" = -2,
			//	"Motion" = -3,
			//	"Camera Orientation" = -4,
			//	"state->dPdu" = -5,
			//	"state->dPdv" = -6,
			//	"state->dPdudu" = -7,
			//	"state->dPdvdv" = -8,
			//	"state->dPdudv" = -9,
			//	"2D Background" = -10,
			}
		}
		repeats
		{
			Name = "Texture repeats";
			Description = "Texture repeats set how many time the texture is repeated within the texture space defined. RenderCost:1";
			UIType = "vector";
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
			UIRange = 0.0 to 10.0 by 0.001;
		}
		alt_x
		{
			Name = "U";
			Description = "Allow to Alternate texture on U, Visible only when repeat X is higher than 1. RenderCost:1";
		}
		alt_y
		{
			Name = "V";
			Description = "Allow to Alternate texture on V, Visible only when repeat Y is higher than 1. RenderCost:1";
		}
		alt_z
		{
			Name = "Z";
			Description = "Not used in this node. Allow to Alternate texture on Z, Visible only when repeat Z is higher than 1. RenderCost:1";
		}
		min
		{
			Name = "Minimum";
			Description = "Allow to remap texture from lower/left corner, Z is ignored. RenderCost:1";
			UIType = "vector";
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
			UIRange = 0.0 to 1.0 by 0.001;
		}
		max
		{
			Name = "Maximum";
			Description = "Allow to remap texture from top/right corner, Z is ignored. RenderCost:1";
			UIType = "vector";
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
			UIRange = 0.0 to 1.0 by 0.001;
		}
		step
		{
			Name = "Step";
			Description = "Step.";
			UIType = "vector";
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
			UIRange = 0.0 to 0.01 by 0.0001;
		}
		factor
		{
			Name = "Factor";
			Description = "Bump Map Factor determine the height of the bump map.";
			UIRange = -20.0 to 20.0 by 0.0001;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
			UIType = "Number"
			{
				SyncSlider = True;
				Decimals = 4;
			}
		}
		torus_u
		{
			Name = "Bumpmap Torus U";
			Description = "Torus U.";
		}
		torus_v
		{
			Name = "Bumpmap Torus V";
			Description = "Torus V.";
		}
		alpha
		{
			Name = "Use Alpha";
			Description = "Use Alpha for bump map.";
		}
		bump_inuse
		{
			Name = "Enable";
			Description = "Enable Bump Mapping";
		}
		alpha_output
		{
			Name = "Use Alpha";
			Description = "Output Alpha as color output";
		}
		alpha_factor
		{
			Name = "Alpha";
			Description = "Set the alpha output strength";
			UIRange = 0.0 to 1.0 by 0.01;
			Commands = "{F5C75F11-2F05-11D3-AA95-00AA0068D2C0}";
		}
		noise_type
		{
			Name = "Type";
			UIType = "combo";
			Items
			{
				"Legacy" = 0,
				"Default" = 1,
			}
		}
	}

	Logic
	{
		Sub bump_inuse_Onchanged()
			pset.alpha.Enable(pset.bump_inuse)	
			pset.factor.Enable(pset.bump_inuse)
			pset.step.Enable(pset.bump_inuse)
		End Sub

		Sub alpha_output_Onchanged()
			pset.alpha_factor.Enable(pset.alpha_output)
		End Sub

		Sub Oninit
			' I really mean it.  Don't show this thing.
			tspace_xform_old.Show(false)
			tspace_xform_old.Enable(false)
			bump_inuse_Onchanged
			alpha_output_Onchanged
		End Sub
	}

	Layout "Default"
	{
		Tab "Texture"
		{
			Name;
			tspace_id;
			Group "Bump Mapping"
			{
				bump_inuse,aligncenter;
				alpha,aligncenter;
				factor,aligncenter;
				step,aligncenter;
			}
		}
		Tab "Wood"
		{
			Name;
			filler_col;
			vein_col;
			vein_spread;
			Group "Copy Alpha to RGB"
			{
				alpha_output,continue,nolabel,35%;
				alpha_factor,65%;
			}
		}
		Tab "Grain"
		{
			Name;
			grain_col;
			grain_bias;
			grain_scale;
			grain_density;
		}
		Tab "Aging"
		{
			Name;
			wobbly_struct,aligncenter;
			age,aligncenter;
			Group "Layer"
			{
				layer_size,aligncenter;
				randomness,aligncenter;
			}
			Group "Center"
			{
				center_u,aligncenter;
				center_v,aligncenter;
			}
		}
		Tab "Fractal"
		{
			Name;
			noise_type;
			ratio,aligncenter;
			complexity,aligncenter;
			uamplitude,aligncenter;
			vamplitude,aligncenter;
			frequencies,aligncenter;
			absolute,aligncenter;
		}
		Tab "Advanced"
		{
			Name;
			Group "Alternate", 100%
			{
				alt_x,aligncenter;
				alt_y,aligncenter;
				alt_z,aligncenter;
			}
			Group "Repeats"
			{
				repeats,aligncenter,nolabel;
			}
			Group "UV Remap", 100%
			{
				min,aligncenter,continue;
				max,aligncenter;
			}
		}
	}


	Layout "RenderTree"
	{
		filler_col;
		vein_col;
		vein_spread;
		alpha_output;
		alpha_factor;
		Group "Grain"
		{
			grain_col;
			grain_bias;
			grain_scale;
			grain_density;
		}
		Group "Aging"
		{
			wobbly_struct;
			age;
			layer_size;
			randomness;
			center_u;
			center_v;
		}
		Group "Fractal"
		{
			ratio;
			complexity;
			uamplitude;
			vamplitude;
			frequencies;
			absolute;
		}
		Group "Bump Mapping"
		{
			bump_inuse;
			alpha;
			factor;
			step;
		}
		Group "Remapping"
		{
			alt_x;
			alt_y;
			alt_z;
			repeats;
			min;
			max;
		}
	}

	Shaderball
	{
		Dimension = Spatial;
		Show	  = true;
	}
	
END
