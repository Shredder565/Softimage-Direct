	MetaShader "material-phong_declare"
	{
		Name = "Phong";
		Type = material, shadow, material photon;
		Renderer "mental ray"
		{
			Name = "material-phong";
			Options
			{
				"version" = 1;
				"pass channel" = "Ambient,Diffuse,Specular,Irradiance,Reflection,Refraction";
			}
			BeginText
			
			Node "rayswitch"		= guid "{8604221E-BCFA-11D1-90E9-0000F804EB21}";
			Node "photon"			= guid "{6D228369-EB66-11D1-8054-00A0C906835D}";
			Node "scalar2color1"	= guid "{8677C42B-BCFA-11D1-90E9-0000F804EB21}";
			Node "scalar2color2"	= guid "{8677C42B-BCFA-11D1-90E9-0000F804EB21}";
			Node "phong" 			= guid "{89C75826-BCFA-11D1-90E9-0000F804EB21}";
			Node "mixer"			= guid "{3A3BD020-A9BD-11D3-AE56-00A0C96E63E1}";
			Node "mixer2"			= guid "{3A3BD020-A9BD-11D3-AE56-00A0C96E63E1}";
			Node "translucent"		= guid "{E22730A1-BDD4-11D1-90EB-0000F804EB21}";
			Node "index_of_ref"		= guid "{50F33F54-B473-11D1-90E1-0000F804EB21}";
			Node "refract"			= guid "{8A97F5E9-BCFA-11D1-90E9-0000F804EB21}";
			Node "reflect"			= guid "{8A64B35A-BCFA-11D1-90E9-0000F804EB21}";
			Node "shadow"			= guid "{1EDE3A06-BF3A-11D1-90EC-0000F804EB21}";
			
			Connection "phong::ambient"				= interface "ambient";
			Connection "phong::ambience"			= interface "ambience";
			Connection "phong::diffuse"				= interface "diffuse";
			Connection "phong::specular"			= interface "specular";
			Connection "phong::shiny"				= interface "shiny";
			Connection "phong::bump"				= interface "bump";
			Connection "phong::radiance"			= interface "radiance";
			Connection "phong::radiance_filter"		= interface "radiance_filter";
			
			Connection "translucent::diffuse"		= interface "diffuse";
			
			Connection "index_of_ref::mtl_ior"		= interface "index_of_refraction";
			
			Connection "photon::diffuse"				= interface "diffuse";
			Connection "photon::specular"				= interface "specular";
			Connection "photon::transpenabled"			= interface "refract_inuse";
			Connection "photon::transparency"			= interface "transparency";
			Connection "photon::usealphatrans"			= interface "usealphatrans";
			Connection "photon::inverttrans"			= interface "inverttrans";
			Connection "photon::scaletrans"				= interface "scaletrans";
			Connection "photon::reflenabled"			= interface "reflect_inuse";
			Connection "photon::reflectivity"			= interface "reflectivity";
			Connection "photon::usealpharefl"			= interface "usealpharefl";
			Connection "photon::invertrefl"				= interface "invertrefl";
			Connection "photon::scalerefl"				= interface "scalerefl";
			Connection "photon::index_of_refraction"	= "index_of_ref::ior";
			
			Connection "shadow::diffuse"			= interface "diffuse";
			Connection "shadow::transpenabled"		= interface "refract_inuse";
			Connection "shadow::transparency"		= interface "transparency";
			Connection "shadow::scaletrans"			= interface "scaletrans";
			Connection "shadow::inverttrans"		= interface "inverttrans";
			Connection "shadow::usealphatrans"		= interface "usealphatrans";
			
			Connection "refract::input"				= "mixer";
			Connection "refract::enabled"			= interface "refract_inuse";
			Connection "refract::refract"			= interface "transparency";
			Connection "refract::usealpha"			= interface "usealphatrans";
			Connection "refract::scale"				= interface "scaletrans";
			Connection "refract::invert"			= interface "inverttrans";
			Connection "refract::alpha"				= value on;
			Connection "refract::ior"				= "index_of_ref::ior";
			Connection "refract::glossy"			= interface "trans_glossy";
			Connection "refract::samples"			= interface "transparent_samples";
			Connection "refract::max_depth"			= value 1;
			
			Connection "reflect::input"				= "refract";
			Connection "reflect::enabled"			= interface "reflect_inuse";
			Connection "reflect::reflect"			= interface "reflectivity";
			Connection "reflect::usealpha"			= interface "usealpharefl";
			Connection "reflect::scale"				= interface "scalerefl";
			Connection "reflect::invert"			= interface "invertrefl";
			Connection "reflect::notrace"			= interface "notrace";
			Connection "reflect::samples"			= interface "reflect_samples";
			Connection "reflect::glossy"			= interface "reflect_glossy";
			Connection "reflect::max_depth"			= value 1;
			
			Connection "mixer::mixersize"		= value 4;
			Connection "mixer::base_color"		= value 0.0 0.0 0.0 0.0;
			
			Connection "mixer::color1"			= "phong::surface";
			Connection "mixer::mode1"			= value 2;
			Connection "mixer::weight1"			= value 1.0 1.0 1.0 1.0;
			Connection "mixer::inuse1"			= interface "diffuse_inuse";
			Connection "mixer::alpha1"			= value off;
			
			Connection "mixer::color2"			= "translucent";
			Connection "mixer::mode2"			= value 2;
			Connection "scalar2color1::input"	= interface "translucency";
			Connection "mixer::weight2"			= "scalar2color1";
			Connection "mixer::inuse2"			= interface "translucent_inuse";
			Connection "mixer::alpha2"			= value off;
			
			Connection "mixer::color3"			= interface "incandescence";
			Connection "mixer::mode3"			= value 2;
			Connection "scalar2color2::input"	= interface "inc_inten";
			Connection "mixer::weight3"			= "scalar2color2";
			Connection "mixer::inuse3"			= interface "incand_inuse";
			Connection "mixer::alpha3"			= value off;
			
			Connection "mixer2::mixersize"		= value 2;
			Connection "mixer2::base_color"		= "reflect";
			
			Connection "mixer2::color1"			= "phong::specular";
			Connection "mixer2::mode1"			= value 2;
			Connection "mixer2::weight1"			= value 1.0 1.0 1.0 0.0;
			Connection "mixer2::inuse1"			= interface "specular_inuse";
			Connection "mixer2::alpha1"			= value off;
			
			Connection "rayswitch::shadow"		= "shadow";
			Connection "rayswitch::photon"		= "photon";
			Connection "rayswitch::eye"			= "mixer2";
			Connection "rayswitch::refraction"	= "mixer2";
			Connection "rayswitch::reflection"	= "mixer2";
			
			Connection root						= "rayswitch";
			EndText
		}
		
		Renderer "MetaSL"
		{
			Name = "msl_soft_phong";
			FileName = "softimage.msl";
			Options
			{
				// Implementation for the different Display Modes
				// Empty string will use the default symbol.
				// Put "ignore" if you want the shader to be skipped silently
				"hqv constant"			=  "msl_soft_illum_constant";
				"hqv shaded"			=  "";
				"hqv textured"			=  "";
				"hqv texturedecal"		=  "msl_soft_illum_constant";
				"hqv proc textured"		=  "";
				"hqv proc texturedecal"	=  "msl_soft_illum_constant";
			}
		}
		
Renderer "Candela"
{
Name = "material-phong_cg";
Options
{
	"param0" = "ambient";
	"param1" = "diffuse";
	"param2" = "specular";
	"param3" = "ambience";
	"param4" = "shiny";
	"const0" = "diffuse_inuse";
	"const1" = "specular_inuse";
	"param7" = "radiance";
}
BeginText
{
	vec4 retval;
	
	//vec4 EPos = mul(mv, g_state.position);      //The eye-space vertex position
	vec4 EPos = g_state.position;      //The eye-space vertex position
		
	//vec3 normal = normalize( mul( (mat3)mvit, g_state.normal.xyz ) );
	vec3 normal = g_state.normal.xyz;

	vec4 ambient_light = gl_LightSource[0].ambient;
	ambient_light.w = 1.0f;

	vec4 diffuse_light = gl_LightSource[0].diffuse;
	diffuse_light.w = 1.0f;

	vec4 specular_light = gl_LightSource[0].specular;
	specular_light.w = 1.0f;
	vec3 vdir = normalize(-EPos);
	vec4 coeffs;
	vec3 vert2light = gl_LightSource[0].position.xyz - EPos;
	vec4 d = length(vert2light);
	vec3 ldir = vert2light/d;           //light direction
	vec3 lightDir;
	vec3 half;

#	if (diffuse_inuse == 0)
	{
		diffuse.x = 0.0;
		diffuse.y = 0.0;
		diffuse.z = 0.0;
		diffuse.w = 0.0;

		ambient.x = 0.0;
		ambient.y = 0.0;
		ambient.z = 0.0;
		ambient.w = 0.0;
	}
#endif

#	if (specular_inuse == 0)
	{
		specular.x = 0.0;
		specular.y = 0.0;
		specular.z = 0.0;
		specular.w = 0.0;
	}
#endif

	if ( gl_LightSource[0].position.w == 0 )	// DIRECTIONAL
	{	

		// hack in a light vector for now
		vec4 LightVec = gl_LightSource[0].position;
		LightVec.w = 1.0;
		lightDir = normalize(LightVec.xyz);

		half = normalize(vdir - lightDir);

		coeffs = lit(dot(normal, - lightDir), dot(normal,half),shiny.x);
		
	

		// Compute the standard shading model
		retval = ambient_light*ambient +               //ambient term
			diffuse_light*diffuse*coeffs.y +            //diffuse term
			specular_light*specular*coeffs.z;             //specular term	
	}

	if ( gl_LightSource[0].position.w == 1 )	// POINT
	{
		
		vec3 halfv = normalize(ldir + vdir); //halfway vector
		coeffs = lit(dot(normal,ldir), dot(normal,halfv), shiny.x);
	
		// Compute the standard shading model
		retval = 1/(gl_LightSource[0].constantAttenuation + d*gl_LightSource[0].linearAttenuation + d*d*gl_LightSource[0].quadraticAttenuation) *
						 (ambient_light*ambient +                       
				  diffuse_light*diffuse*coeffs.y +            
				  specular_light*specular*coeffs.z);            
	
	}

	if ( gl_LightSource[0].position.w == 2 )	// SPOT
	{
		
		half = normalize(ldir + vdir); //halfway vector
	
		// Compute the diffuse and specular coefficients
		coeffs = lit(dot(normal,ldir), dot(normal,half), shiny.x);
	
		// Compute spotlight effect
		lightDir = normalize(gl_LightSource[0].position.xyz);
		vec4 spotDot = dot(ldir, -lightDir);
		vec4 spot  = lit(spotDot - gl_LightSource[0].spotCutoff, spotDot, gl_LightSource[0].spotCosCutoff);
	
		// Compute the standard shading model
		retval = 1/(gl_LightSource[0].constantAttenuation + d*gl_LightSource[0].linearAttenuation + d*d*gl_LightSource[0].quadraticAttenuation) *   //attenuation term
						 (ambient_light*ambient +                       //ambient term
				  diffuse_light*diffuse*coeffs.y +            //diffuse term
				  specular_light*specular*coeffs.z);            //specular term
	
	}

	return retval;

}
EndText
}
	}

BEGIN "{24810490-56FF-11d2-BF23-00A0C982CE5D}"
HelpFile = "<FactoryPath>/Doc/<DocLangPref>/xsidocs.chm::/shaderpresets48.htm";
	Defaults
	{
		radiance
		{
			Name = "Radiance";
			Description = "Radiance";
			UIType = "rgb",4;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		ambient
		{
			Name = "Ambient";
			Description = "Ambient Color determine how strong the Global Ambience (indirect illumination) will affect the object. RenderCost:1";
			UIType = "rgb",4;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		diffuse
		{
			Name = "Color";
			Description = "Diffuse Color determine the surface color in the illuminated area of the object. This value get blended with Ambient color. RenderCost:1";
			UIType = "rgb",4;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		specular
		{
			Name = "Color";
			Description = "Specular Color determine color of the surface highlight. RenderCost:1";
			UIType = "rgb",4;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		ambience
		{
			Name = "Ambience";
			Description = "Ambience is a parameter shared in the entire scene, it determines the Global Indirect Scene Illumination. RenderCost:1";
			UIType = "rgb",4;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		shiny
		{
			Name = "Specular Decay";
			Description = "Specular Decay RenderCost:?";
			UIRange = 0.0 to 300.0 by 0.01;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		transparency
		{
			Name = "Color";
			Description = "Transparency color. RenderCost:2";
			UIType = "rgba",4;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		trans_glossy
		{
			Name = "Frost";
			Description = "Transparency Frost. RenderCost:3";
			UIRange = 0.0 to 0.5 by 0.01;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		transparent_samples
		{
			Name = "Samples";
			Description = "Transparency Frost Samples. RenderCost:3";
			UIRange = 0 to 10 by 1;
		}
		reflectivity
		{
			Name = "Color";
			Description = "Reflectivity Color. RenderCost:2";
			UIType = "rgba",4;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		reflect_glossy
		{
			Name = "Gloss";
			Description = "Reflectivity Gloss. RenderCost:3";
			UIRange = 0.0 to 0.5 by 0.01;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		reflect_samples
		{
			Name = "Samples";
			Description = "Reflectivity Gloss Samples. RenderCost:3";
			UIRange = 0 to 10 by 1;
		}
		index_of_refraction
		{
			Name = "Index of Refraction";
			Description = "Index of Refraction. RenderCost:1";
			UIRange = 0.0 to 5.0 by 0.01;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		translucency
		{
			Name = "Translucency";
			Description = "Translucency factor determine the blending factor between front/back illumination. 0.0 = no blending at all. RenderCost:1";
			UIRange = 0.0 to 1.0 by 0.01;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		incandescence
		{
			Name = "Incandescence";
			Description = "Incandescence is color being added to object's ambience. RenderCost:1";
			UIType = "rgb",4;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		inc_inten
		{
			Name = "Intensity";
			Description = "Incandescence Intensity set the stenght of the incandescence color. 0.0: no visibile incandesence RenderCost:1";
			UIRange = 0.0 to 1.0 by 0.01;
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
		bump
		{
			Name = "Bump Mapping";
			Description = "Bump Mapping parameter is used to disturb object surface normals, prior to illumination calculation. This create a bump mapping over sruface. RenderCost:1";
			UIType = "vector";
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
			UIRange = 0.0 to 1.0 by 0.001;
		}
		diffuse_inuse
		{
			Name = "Enable";
			Description = "Enable Diffuse";
			UIType = "check";			
		}		
		specular_inuse
		{
			Name = "Enable";
			Description = "";
			UIType = "check";			
		}		
		reflect_inuse
		{
			Name = "Enable";
			Description = "Enable Reflection";
			UIType = "check";			
		}		
		refract_inuse
		{
			Name = "Enable";
			Description = "Enable Transparency and Refraction";
			UIType = "check";			
		}		
		incand_inuse
		{
			Name = "Enable";
			Description = "Enable Incandescence";
			UIType = "check";			
		}		
		translucent_inuse
		{
			Name = "Enable";
			Description = "Enable Translucency";
			UIType = "check";			
		}		
		notrace
		{
			Name = "Reflection Mode";
			Description = "Reflection Mode";
			UIType = "combo";
			Items
			{
				"Raytracing Enable" = 0,
				"Environment Only" = 1,
			}
		}
		scaletrans
		{
			Name = "Scale";
			Description = "Amount to scale the transparency color";
			UIRange = 0 to 1 by 0.01;
		}
		inverttrans
		{
			Name = "Invert";
			Description = "Interpret as opacity";
		}
		usealphatrans
		{
			Name = "Use Alpha";
			Description = "Use the alpha of the transparency color";
		}
		scalerefl
		{
			Name = "Scale";
			Description = "Amount to scale the reflect color";
			UIRange = 0 to 1 by 0.01;
		}
		invertrefl
		{
			Name = "Invert";
			Description = "Invert reflect color";
		}
		usealpharefl
		{
			Name = "Use Alpha";
			Description = "Use the alpha of the reflect color";
		}
		radiance_filter
		{
			Name = "Filter Radiance with Diffuse";
			Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		}
	}
	
	Logic
	{
		sub diffuse_inuse_Onchanged()
			pset.diffuse.Enable(pset.diffuse_inuse.Value = TRUE)
			pset.ambient.Enable(pset.diffuse_inuse.Value = TRUE)
		end sub

		sub specular_inuse_Onchanged()
			pset.specular.Enable(pset.specular_inuse.Value = TRUE)
			pset.shiny.Enable(pset.specular_inuse.Value = TRUE)
		end sub

		sub reflect_inuse_Onchanged()
			enabled = (pset.reflect_inuse.Value = TRUE)
			pset.reflectivity.Enable(enabled)
			pset.reflect_glossy.Enable(enabled)
			pset.reflect_samples.Enable(enabled)
			pset.notrace.Enable(enabled)
			pset.scalerefl.Enable(enabled)
			pset.invertrefl.Enable(enabled)
			pset.usealpharefl.Enable(enabled)
		end sub

		sub refract_inuse_Onchanged()
			enabled = (pset.refract_inuse.Value = TRUE)
			pset.transparency.Enable(enabled)
			pset.trans_glossy.Enable(enabled)
			pset.transparent_samples.Enable(enabled)
			pset.index_of_refraction.Enable(enabled)
			pset.scaletrans.Enable(enabled)
			pset.inverttrans.Enable(enabled)
			pset.usealphatrans.Enable(enabled)
		end sub

		sub translucent_inuse_Onchanged()
			pset.translucency.Enable(pset.translucent_inuse.Value = TRUE)
		end sub
		
		sub incand_inuse_Onchanged()
			pset.incandescence.Enable(pset.incand_inuse.Value = TRUE)
			pset.inc_inten.Enable(pset.incand_inuse.Value = TRUE)
		end sub

		Sub OnInit
			diffuse_inuse_Onchanged
			specular_inuse_Onchanged
			reflect_inuse_Onchanged
			refract_inuse_Onchanged
			translucent_inuse_Onchanged
			incand_inuse_Onchanged
		End Sub
	}

	Layout "Default"
	{
		Tab "Illumination"
		{
			Name;
			Group "Diffuse"
			{
				diffuse_inuse;
				diffuse;
				ambient;
			}
			Group "Specular"
			{
				specular_inuse;
				specular;
				shiny;
			}
		}
		Tab "Transparency / Reflection"
		{
			Name;
			Group "Transparency"
			{
				refract_inuse;
				Group "Mix color"
				{
					transparency;
					usealphatrans,continue,AlignRight;
					inverttrans,AlignRight;
					scaletrans;
				}
				trans_glossy;
				transparent_samples;
				index_of_refraction;
			}
			Group "Reflection"
			{
				reflect_inuse;
				Group "Mix color"
				{
					reflectivity;
					usealpharefl,continue,AlignRight;
					invertrefl,AlignRight;
					scalerefl;
				}
				reflect_glossy;
				reflect_samples;			
				notrace;
			}
		}
		Tab "Indirect Illumination"
		{
			Name;
			Group "Global Illumination / Caustics / Final Gathering"
			{
				radiance;
				radiance_filter;
			}
			Group "Translucency"
			{
				translucent_inuse;
				translucency;
			}
			Group "Incandescence"
			{
				incand_inuse;
				incandescence;
				inc_inten;
			}
		}
	}

	Layout "X3D"
	{
		Group "Diffuse"
		{
			diffuse,NoLabel;
		}
		Group "Ambient"
		{
			ambient,NoLabel;
		}
		Group "Specular"
		{
			specular,NoLabel;
			shiny;
		}
		Group "Transparency"
		{
			refract_inuse;
			transparency,NoLabel;
			trans_glossy;
			transparent_samples;
			index_of_refraction;
		}
		Group "Reflection"
		{
			reflect_inuse;
			reflectivity,NoLabel;
			reflect_glossy;
			reflect_samples;			
		}
	}

	Layout "RenderTree"
	{
		Group "Illumination"
		{
			ambient;
			diffuse;
			specular;
			shiny;
			bump;
			diffuse_inuse;
			specular_inuse;
		}
		Group "Transparency"
		{
			transparency;
			refract_inuse;
			usealphatrans;
			inverttrans;
			scaletrans;
			trans_glossy;
			transparent_samples;
			index_of_refraction;
		}
		Group "Reflection"
		{
			reflectivity;
			reflect_inuse;
			usealpharefl;
			invertrefl;
			scalerefl;
			reflect_glossy;
			reflect_samples;			
			notrace;
		}
		Group "Indirect Illumination"
		{
			radiance;
			radiance_filter;
			translucency;
			translucent_inuse;
			incandescence;
			incand_inuse;
			inc_inten;
		}
	}
	
	Shaderball
	{
		Dimension = Spatial;
	}

END
