SPDL
version = "2.0.0.0";
Reference = "{DE6E9BD4-DF7A-11D1-804B-00A0C906835D}";
	PropertySet "txt2d-grid_params"
	{
		Parameter "out" output
		{
			title = "Grid";
			guid = "{4C6879FF-7EC8-11D0-8E3B-00A0C90640EC}";
			type = color;
		}
		Parameter "line_color" input
		{
			title = "line_color";
			guid = "{7F0B8010-CC1B-11D2-8BF3-00A0243E3672}";
			type = color;
			value = 1.0 0.8 0.6 1.0;
			flags  = 1;
			texturable = on;
		}
		Parameter "fill_color" input
		{
			title = "fill_color";
			guid = "{7F119CD0-CC1B-11D2-8BF3-00A0243E3672}";
			type = color;
			value = 0.1 0.3 0.6 1.0;
			flags  = 1;
			texturable = on;
		}
		Parameter "u_width" input
		{
