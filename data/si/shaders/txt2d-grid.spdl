			flags  = 1;
			value = 0.2;
			texturable = on;
		}
		Parameter "v_width" input
		{
			title = "v_width";
			guid = "{7F1DD650-CC1B-11D2-8BF3-00A0243E3672}";
			type = scalar;
			flags  = 1;
