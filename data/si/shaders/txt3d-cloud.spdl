		Parameter "texhomog" input # Are the uv coordinates homogeneous? (homogeneous coordinate stored in w, since we currently don't have 4d homogeneous)
		{
			title = "texthomog";
			guid = "{192E69C2-1A81-4364-B793-7BAE6733C3C4}";
			ui "mapping"  = "{3458F753-D5D2-4B8C-80A9-802853ABEF57}"; # GUID_3D_MAPTO_HOMOGENEOUS_COORDS
			type = boolean;
			texturable = off;
			animatable = false;
			persistable = false;	# Data never saved: generated by the projection
			inspectable = false;
		}

		#--------- The previous set of parameters cannot be set manually by users.
		#--------- Softimage will fill these values automatically based on the tspace_id
		#--------- To use this data in another shader, copy the ui "mapping"s for each parameter.

		Parameter "project_old" input
