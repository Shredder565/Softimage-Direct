		Connection "gradient_bump::alpha4"					= interface "alpha4";
		Connection "gradient_bump::pos_alpha4"				= interface "pos_alpha4";
		Connection "gradient_bump::mid_alpha4"				= interface "mid_alpha4";
		Connection "gradient_bump::alpha5"					= interface "alpha5";
		Connection "gradient_bump::pos_alpha5"				= interface "pos_alpha5";
		Connection "gradient_bump::mid_alpha5"				= interface "mid_alpha5";
		Connection "gradient_bump::alpha6"					= interface "alpha6";
		Connection "gradient_bump::pos_alpha6"				= interface "pos_alpha6";
		Connection "gradient_bump::mid_alpha6"				= interface "mid_alpha6";
		Connection "gradient_bump::alpha7"					= interface "alpha7";
		Connection "gradient_bump::pos_alpha7"				= interface "pos_alpha7";
		Connection "gradient_bump::mid_alpha7"				= interface "mid_alpha7";
		Connection "gradient_bump::alpha8"					= interface "alpha8";
		Connection "gradient_bump::pos_alpha8"				= interface "pos_alpha8";
		Connection "gradient_bump::mid_alpha8"				= interface "mid_alpha8";
		
		Connection "basis::ntex"			= interface "tspace_id";
		Connection "basis::project"			= interface "project";
		
		Connection "bump::coord"				= "uvwgen";
		Connection "bump::u"					= "basis::u";
		Connection "bump::v"					= "basis::v";
		Connection "bump::step"					= interface "step";
		Connection "bump::factor" 				= interface "factor";
		Connection "bump::torus_u"				= interface "torus_u";
		Connection "bump::torus_v"				= interface "torus_v";
		Connection "bump::alpha"  				= interface "alpha";
		Connection "bump::tex"					= value "gradient_bump";
		Connection "bump::clamp"				= value off;
		
		Connection "color2alpha::input" 		= "gradient";
		Connection "color2alpha::factor"		= interface "alpha_factor";
		Connection "switch::input1"				= "gradient";
		Connection "switch::input2"				= "color2alpha";
		Connection "switch::switch"				= interface "alpha_output";
		
		#---- perturb surface normal (bumpmap)
		Connection "setnormal::input"			= "switch";
		Connection "setnormal::normal"			= "bump";
		Connection "setnormal::inuse"			= interface "bump_inuse";
		
		Connection root							= "setnormal";
		
		EndText
	}
	Renderer "MetaSL"
	{
		Name = "msl_soft_txt2d_gradientv2";
		FileName = "softimage.msl";
	}
}

BEGIN "{24810490-56FF-11d2-BF23-00A0C982CE5D}"
HelpFile = "<FactoryPath>/Doc/<DocLangPref>/xsidocs.chm::/shaderpresets700.htm";
Defaults
{
	bump_inuse
	{
		Name = "Enable";
		Description = "Enable Bump Mapping";
	}
	step
	{
		Name = "Step";
		Description = "Step.";
		UIType = "vector";
		Commands = "{F5C75F11-2F05-11D3-AA95-00AA0068D2C0}";
		UIRange = 0.0 to 0.01 by 0.0001;
	}
	factor
	{
		Name = "Factor";
		Description = "Bump Map Factor determine the height of the bump map.";
		UIRange = -20.0 to 20.0 by 0.0001;
		Commands = "{F5C75F11-2F05-11D3-AA95-00AA0068D2C0}";
		UIType = "Number"
		{
			SyncSlider = True;
			Decimals = 4;
		}
	}
	torus_u
	{
		Name = "Bumpmap Torus U";
		Description = "Torus U.";
	}
	torus_v
	{
		Name = "Bumpmap Torus V";
		Description = "Torus V.";
	}
	tspace_id
	{
		Name = "Texture Space";
		Description = "Allows choosing the source space for projections. RenderCost:1";
		UIType = "TextureSpaceItem.TextureSpaceItem.1";
		Items
		{
		//	"Intersection" = -1,
		//	"Surface Orientation" = -2,
		//	"Motion" = -3,
		//	"Camera Orientation" = -4,
		//	"state->dPdu" = -5,
		//	"state->dPdv" = -6,
		//	"state->dPdudu" = -7,
		//	"state->dPdvdv" = -8,
		//	"state->dPdudv" = -9,
		//	"2D Background" = -10,
		}
	}
	repeats
	{
		Name = "Texture repeats";
		Description = "Texture repeats set how many time the texture is repeated within the texture space defined. RenderCost:1";
		UIType = "vector";
		Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		UIRange = 0.0 to 10.0 by 0.001;
	}
	alt_x
	{
		Name = "U";
		Description = "Allow to Alternate texture on U, Visible only when repeat X is higher than 1.";
		UIType = "iconlist"
		{
		   nocol      = 2;
		   useselicon = True;
		}
		Items
		{
		   "bitmaps/alternateuon.bmp" = 1,
		   "bitmaps/alternatealloff.bmp" = 0,
		}
	}
	alt_y
	{
		Name = "V";
		Description = "Allow to Alternate texture on V, Visible only when repeat Y is higher than 1.";
		UIType = "iconlist"
		{
		   nocol      = 2;
		   useselicon = True;
		}
		Items
		{
		   "bitmaps/alternatevon.bmp" = 1,
		   "bitmaps/alternatealloff.bmp" = 0,
		}
	}
	alt_z
	{
		Name = "Z";
		Description = "Not used in this node. Allow to Alternate texture on Z, Visible only when repeat Z is higher than 1. RenderCost:1";
	}
	min
	{
		Name = "Minimum";
		Description = "Allow to remap texture from lower/left corner, Z is ignored. RenderCost:1";
		UIType = "vector";
		Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		UIRange = 0.0 to 1.0 by 0.001;
	}
	max
	{
		Name = "Maximum";
		Description = "Allow to remap texture from top/right corner, Z is ignored. RenderCost:1";
		UIType = "vector";
		Commands = "{F5C75F11-2F05-11d3-AA95-00AA0068D2C0}";
		UIRange = 0.0 to 1.0 by 0.001;
	}
	enable_alpha_gradient
	{
		Name = "Enable alpha gradient";
		Description = "Enable alpha gradient";
	}
	range_min
	{
		Name = "Minimum";
		Description = "Minimum";
		UIRange = -1 to 1 by 0.001;
	}
	range_max
	{
		Name = "Maximum";
		Description = "Maximum";
		UIRange = -1 to 1 by 0.001;
	}
