	Function SetRGBAMarker(shader,index,r,g,b,a,pos,mid)
		on error resume next
		SetValue shader & ".color"&index&".red", r
		on error resume next
		SetValue shader & ".color"&index&".green", g
		on error resume next
		SetValue shader & ".color"&index&".blue", b
		on error resume next
		SetValue shader & ".color"&index&".alpha", a
		on error resume next
		SetValue shader & ".pos_color"&index, pos
		on error resume next
		SetValue shader & ".mid_color"&index, mid
	end function

	Function SetAlphaMarker(shader,index,a,pos,mid)
		on error resume next
		SetValue shader & ".alpha"&index, a
		on error resume next
		SetValue shader & ".pos_alpha"&index, pos
		on error resume next
		SetValue shader & ".mid_alpha"&index, mid
	end function

	'***************************************
	' Alpha Gradient presets
	'***************************************
	Sub Alpha_BW_preset_OnClicked()
		on error resume next
		dim shaderArray,item
		shaderArray = split(PSet.InspectedObjects,",")
		for each item in shaderArray
			on error resume next
			SetValue item & ".enable_alpha_gradient", true
			SetAlphaMarker item,	1,	0,	0,	0.5
			SetAlphaMarker item,	2,	1,	1,	0.5
			SetAlphaMarker item,	3,	1,	-1,	0.5
			SetAlphaMarker item,	4,	1,	-1,	0.5
			SetAlphaMarker item,	5,	1,	-1,	0.5
			SetAlphaMarker item,	6,	1,	-1,	0.5
			SetAlphaMarker item,	7,	1,	-1,	0.5
			SetAlphaMarker item,	8,	1,	-1,	0.5
		next
	end sub

	Sub Alpha_WB_preset_OnClicked()
		on error resume next
		dim shaderArray,item
		shaderArray = split(PSet.InspectedObjects,",")
		for each item in shaderArray
			on error resume next
			SetValue item & ".enable_alpha_gradient", true
			SetAlphaMarker item,	1,	1,	0,	0.5
			SetAlphaMarker item,	2,	0,	1,	0.5
			SetAlphaMarker item,	3,	1,	-1,	0.5
			SetAlphaMarker item,	4,	1,	-1,	0.5
			SetAlphaMarker item,	5,	1,	-1,	0.5
			SetAlphaMarker item,	6,	1,	-1,	0.5
			SetAlphaMarker item,	7,	1,	-1,	0.5
			SetAlphaMarker item,	8,	1,	-1,	0.5
		next
	end sub

	'***************************************
	' Remove Anim functions
	'***************************************

	Sub RemoveKeyRGBAMarkers_OnClicked()
		on error resume next
		dim shaderArray,item
		shaderArray = split(PSet.InspectedObjects,",")
		for each item in shaderArray
			on error resume next
			RemoveKeyRGBAMarker item,	1
			RemoveKeyRGBAMarker item,	2
			RemoveKeyRGBAMarker item,	3
			RemoveKeyRGBAMarker item,	4
			RemoveKeyRGBAMarker item,	5
			RemoveKeyRGBAMarker item,	6
			RemoveKeyRGBAMarker item,	7
			RemoveKeyRGBAMarker item,	8
		next
	End Sub

	Function RemoveKeyRGBAMarker(shader,index)
		on error resume next
		RemoveAllAnimation shader & ".color"&index&".red"
		RemoveAllAnimation shader & ".color"&index&".green"
		RemoveAllAnimation shader & ".color"&index&".blue"
		RemoveAllAnimation shader & ".color"&index&".alpha"
		RemoveAllAnimation shader & ".pos_color"&index
		RemoveAllAnimation shader & ".mid_color"&index
	end function

	Sub RemoveKeyAlphaMarkers_OnClicked()
		on error resume next
		dim shaderArray,item
		shaderArray = split(PSet.InspectedObjects,",")
		for each item in shaderArray
			on error resume next
			RemoveKeyAlphaMarker item,	1
			RemoveKeyAlphaMarker item,	2
			RemoveKeyAlphaMarker item,	3
			RemoveKeyAlphaMarker item,	4
			RemoveKeyAlphaMarker item,	5
			RemoveKeyAlphaMarker item,	6
			RemoveKeyAlphaMarker item,	7
			RemoveKeyAlphaMarker item,	8
		next
	End Sub

	Function RemoveKeyAlphaMarker(shader,index)
		on error resume next
		RemoveAllAnimation shader & ".alpha"&index
		RemoveAllAnimation shader & ".pos_alpha"&index
		RemoveAllAnimation shader & ".mid_alpha"&index
	end function

	'***************************************
	' Remove Shader functions
	'***************************************
	Sub RemoveAllShadersOnRGBA_Onclicked()
		on error resume next
		dim shaderArray,item
		shaderArray = split(PSet.InspectedObjects,",")
		for each item in shaderArray
			on error resume next
			RemoveAllshadersRGBAMarkers item,	1
			RemoveAllshadersRGBAMarkers item,	2
			RemoveAllshadersRGBAMarkers item,	3
			RemoveAllshadersRGBAMarkers item,	4
			RemoveAllshadersRGBAMarkers item,	5
			RemoveAllshadersRGBAMarkers item,	6
			RemoveAllshadersRGBAMarkers item,	7
			RemoveAllshadersRGBAMarkers item,	8
		next
	End Sub

	Sub RemoveAllShadersOnAlpha_Onclicked()
		on error resume next
		dim shaderArray,item
		shaderArray = split(PSet.InspectedObjects,",")
		for each item in shaderArray
			on error resume next
			RemoveAllshadersAlphaMarkers item,	1
			RemoveAllshadersAlphaMarkers item,	2
			RemoveAllshadersAlphaMarkers item,	3
			RemoveAllshadersAlphaMarkers item,	4
			RemoveAllshadersAlphaMarkers item,	5
			RemoveAllshadersAlphaMarkers item,	6
			RemoveAllshadersAlphaMarkers item,	7
			RemoveAllshadersAlphaMarkers item,	8
		next
	End Sub

	Function RemoveAllshadersRGBAMarkers(shader,index)
		on error resume next
		RemoveAllShadersFromCnxPoint shader & ".color" & index
		on error resume next
		RemoveAllShadersFromCnxPoint shader & ".pos_color" & index
		on error resume next
		RemoveAllShadersFromCnxPoint shader & ".mid_color" & index
	End Function

	Function RemoveAllshadersAlphaMarkers(shader,index)
		on error resume next
		RemoveAllShadersFromCnxPoint shader & ".alpha" & index
		on error resume next
		RemoveAllShadersFromCnxPoint shader & ".pos_alpha" & index
		on error resume next
		RemoveAllShadersFromCnxPoint shader & ".mid_alpha" & index
	End Function


	'***************************************
	' Reset Gradient
	'***************************************
	Sub ResetRGBAMarkers_Onclicked()
		on error resume next
		RemoveKeyRGBAMarkers_OnClicked()
		RGBA_spectrum_preset_OnClicked()
	End Sub

	Sub ResetAlphaMarkers_Onclicked()
		on error resume next
		RemoveKeyAlphaMarkers_OnClicked()
		Alpha_BW_preset_OnClicked()
	End Sub

	'***************************************
	' Set key functions
	'***************************************
	Sub SaveKeyAllVisibleRGBAMarkers_OnClicked()
		on error resume next
		dim shaderArray,item
		shaderArray = split(PSet.InspectedObjects,",")
		for each item in shaderArray
			SetKeyVisibleRGBAMarker item,	1
			SetKeyVisibleRGBAMarker item,	2
			SetKeyVisibleRGBAMarker item,	3
			SetKeyVisibleRGBAMarker item,	4
			SetKeyVisibleRGBAMarker item,	5
			SetKeyVisibleRGBAMarker item,	6
			SetKeyVisibleRGBAMarker item,	7
			SetKeyVisibleRGBAMarker item,	8
		next
	end sub

	Function SetKeyVisibleRGBAMarker (shader,index)
		on error resume next
		if ( GetValue(shader&".pos_color"&index) >= 0 and GetValue(shader&".pos_color"&index) <= 1 ) then
			SetKey shader & ".color"&index&".red",,GetValue(shader&".color"&index&".red")
			SetKey shader & ".color"&index&".green",,GetValue(shader&".color"&index&".green")
			SetKey shader & ".color"&index&".blue",,GetValue(shader&".color"&index&".blue")
			SetKey shader & ".color"&index&".alpha",,GetValue(shader&".color"&index&".alpha")
			SetKey shader & ".pos_color"&index,,GetValue(shader&".pos_color"&index)
			SetKey shader & ".mid_color"&index,,GetValue(shader&".mid_color"&index)
		end if
	end function

	Sub SaveKeyAllVisibleAlphaMarkers_OnClicked()
		on error resume next
		dim shaderArray,item
		shaderArray = split(PSet.InspectedObjects,",")
		for each item in shaderArray
			SetKeyVisibleAlphaMarker item,	1
			SetKeyVisibleAlphaMarker item,	2
			SetKeyVisibleAlphaMarker item,	3
			SetKeyVisibleAlphaMarker item,	4
			SetKeyVisibleAlphaMarker item,	5
			SetKeyVisibleAlphaMarker item,	6
			SetKeyVisibleAlphaMarker item,	7
			SetKeyVisibleAlphaMarker item,	8
		next
	end sub

	Function SetKeyVisibleAlphaMarker(shader,index)
		on error resume next
		if ( GetValue(shader&".pos_alpha"&index) >= 0 and GetValue(shader&".pos_alpha"&index) <= 1 ) then
			SetKey shader & ".alpha"&index,,GetValue(shader&".alpha"&index)
			SetKey shader & ".pos_alpha"&index,,GetValue(shader&".pos_alpha"&index)
			SetKey shader & ".mid_alpha"&index,,GetValue(shader&".mid_alpha"&index)
		end if
	end function


	'***************************************
	' UI logic
	'***************************************
	Sub bump_inuse_Onchanged()
		pset.alpha.Enable(pset.bump_inuse)	
		pset.factor.Enable(pset.bump_inuse)
		pset.step.Enable(pset.bump_inuse)
	End Sub

	sub enable_alpha_gradient_OnChanged
		on error resume next
		pset.alpha_interpolation.Enable(enable_alpha_gradient)
	end sub
	
	sub OnInit
		on error resume next
		bump_inuse_Onchanged
		enable_alpha_gradient_OnChanged
	end Sub
}
Layout "Default"
{
	Tab "RGBA Gradient"
	{
		Name;
		rgba_interpolation, nolabel;
		gradient_type, aligncenter;
		invert, aligncenter;
		clip, aligncenter;
		Group "Copy Alpha to RGB"
		{
			alpha_output,aligncenter;
			alpha_factor,aligncenter;
		}
		Group "Animation"
		{
			Button SaveKeyAllVisibleRGBAMarkers,continue,aligncenter = "Key All",140;
			Button RemoveKeyRGBAMarkers,aligncenter = "Remove keys",140;
			Button ResetRGBAMarkers,continue,aligncenter = "Reset",140;
			Button RemoveAllShadersOnRGBA,aligncenter = "Remove Shaders",140;
		}
		group "Preset"
		{
			Group "", 50%,continue
			{
				Button RGBA_BW_preset,aligncenter = "Black/White",140;
				Button RGBA_WB_preset,aligncenter = "White/Black",140;
				Button RGBA_BTR_preset,aligncenter = "Black to transparent",140;
				Button RGBA_WTR_preset,aligncenter = "White to transparent",140;
			}
			Group "",50%
			{
				Button RGBA_chrome_preset,aligncenter = "Chrome",140;
				Button RGBA_copper_preset,aligncenter = "Copper",140;
				Button RGBA_spectrum_preset,aligncenter = "Spectrum",140;
				Button RGBA_rainbow_preset,aligncenter = "Rainbow",140;
				Button RGBA_fire_preset,aligncenter = "Fire",140;
			}
		}
	}
	Tab "Alpha Gradient"
	{
		Name;
		enable_alpha_gradient, aligncenter;
		alpha_interpolation, nolabel;
		gradient_type, aligncenter;
		invert, aligncenter;
		clip, aligncenter;
		Group "Copy Alpha to RGB"
		{
			alpha_output,aligncenter;
			alpha_factor,aligncenter;
		}
		Group "Animation"
		{
			Button SaveKeyAllVisibleAlphaMarkers,continue,aligncenter = "Key All",140;
			Button RemoveKeyAlphaMarkers,aligncenter = "Remove keys",140;
			Button ResetAlphaMarkers,continue,aligncenter = "Reset",140;
			Button RemoveAllShadersOnAlpha,aligncenter = "Disconnect all",140;
		}
		Group "Preset"
		{
			Button Alpha_BW_preset,continue,aligncenter = "Black and White",140;
			Button Alpha_WB_preset,continue,aligncenter = "White and Black",140;
		}
	}
	Tab "Texture"
	{
		Name;
		tspace_id;
		Group "Bump Mapping"
		{
			bump_inuse,aligncenter;
			alpha,aligncenter;
			factor,aligncenter;
			step,aligncenter;
		}
	}
	Tab "Advanced"
	{
		Name;
		Group "Alternate", 100%
		{
			alt_x,aligncenter,continue;
			alt_y,aligncenter;
		}
		Group "Repeats", 100%
		{
			repeats,aligncenter;
		}
		Group "UV Remap", 100%
		{
			min,aligncenter,continue;
			max,aligncenter;
		}
	}
}

	Layout "RenderTree"
	{
		alpha_output;
		alpha_factor;
		range_min;
		range_max;
		Group "Color 1"
		{
			color1;
			pos_color1;
			alpha1;
			pos_alpha1;
			mid_alpha1;
		}
		Group "Color 2"
		{
			color2;
			pos_color2;
			alpha2;
			pos_alpha2;
			mid_alpha2;
		}
		Group "Color 3"
		{
			color3;
			pos_color3;
			alpha3;
			pos_alpha3;
			mid_alpha3;
		}
		Group "Color 4"
		{
			color4;
			pos_color4;
			alpha4;
			pos_alpha4;
			mid_alpha4;
		}
		Group "Color 5"
		{
			color5;
			pos_color5;
			alpha5;
			pos_alpha5;
			mid_alpha5;
		}
		Group "Color 6"
		{
			color6;
			pos_color6;
			alpha6;
			pos_alpha6;
			mid_alpha6;
		}
		Group "Color 7"
		{
			color7;
			pos_color7;
			alpha7;
			pos_alpha7;
			mid_alpha7;
		}
		Group "Color 8"
		{
			color8;
			pos_color8;
			alpha8;
			pos_alpha8;
			mid_alpha8;
		}
		Group "Bump Mapping"
		{
			bump_inuse,aligncenter;
			alpha,aligncenter;
			factor,aligncenter;
			step,aligncenter;
		}
		Group "Remapping"
		{
			alt_x;
			alt_y;
			alt_z;
			repeats;
			torus_u;
			torus_v;
			min;
			max;
		}
	}

	
	Shaderball
	{
		Dimension = Parametric;
		Show	  = true;
	}
END
