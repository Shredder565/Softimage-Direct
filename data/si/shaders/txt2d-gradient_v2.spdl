Logic
{
	'***************************************
	' RGBA Gradient presets
	'***************************************
	Sub RGBA_chrome_preset_OnClicked()
		on error resume next
		dim shaderArray,item
		shaderArray = split(PSet.InspectedObjects,",")
		for each item in shaderArray
			on error resume next
			SetRGBAMarker item ,1, 0.2,	0.65,	0.9,	1,	0.0	,0.5
			SetRGBAMarker item ,2, 1, 	1,	1,	1,	0.47	,0.5
			SetRGBAMarker item ,3, 0.82,	0.575,	0.275,	1,	0.52	,0.5
			SetRGBAMarker item ,4, 1,	1,	1,	1,	1.0	,0.5
			SetRGBAMarker item ,5, 0, 	0,	0,	0,	-1	,0.5
			SetRGBAMarker item ,6, 0, 	0,	0, 	0,	-1	,0.5
			SetRGBAMarker item ,7, 0, 	0,	0,	0,	-1	,0.5
			SetRGBAMarker item ,8, 0,	0,	0,	0,	-1	,0.5
		next
	end sub

	Sub RGBA_copper_preset_OnClicked()
		on error resume next
		dim shaderArray,item
		shaderArray = split(PSet.InspectedObjects,",")
		for each item in shaderArray
			on error resume next
			SetRGBAMarker item,1, 0.98,	0.85,	0.77,	1,	0.0	,0.5
			SetRGBAMarker item,2, 0.4, 	0.18,	0.09,	1,	0.33	,0.5
			SetRGBAMarker item,3, 0.98,	0.85,	0.77,	1,	0.66	,0.5
			SetRGBAMarker item,4, 0.4, 	0.18,	0.09,	1,	1.0	,0.5
			SetRGBAMarker item,5, 0, 	0,	0,	0,	-1	,0.5
			SetRGBAMarker item,6, 0, 	0,	0, 	0,	-1	,0.5
			SetRGBAMarker item,7, 0, 	0,	0,	0,	-1	,0.5
			SetRGBAMarker item,8, 0,	0,	0,	0,	-1	,0.5
		next
	end sub

	Sub RGBA_spectrum_preset_OnClicked()
		on error resume next
		dim shaderArray,item
		shaderArray = split(PSet.InspectedObjects,",")
		for each item in shaderArray
			on error resume next
			SetRGBAMarker item,1, 1,	0,	0,	1,	0.0	,0.5
			SetRGBAMarker item,2, 1, 	0,	1,	1,	0.20	,0.5
			SetRGBAMarker item,3, 0,	0,	1,	1,	0.35	,0.5
			SetRGBAMarker item,4, 0, 	1,	1,	1,	0.50	,0.5
