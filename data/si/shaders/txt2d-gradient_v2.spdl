MetaShader "txt2d-gradient_v2_declare"
{
	Name = "Gradient";
	Type = texture;
	Renderer "mental ray"
	{
		Name = "txt2d-gradient_v2";
		Options
		{
			"version" = 1;
		}
		BeginText
		
		Node "gradient" 		= guid "{B3745FE2-3947-455A-B6BE-18CD5FF94639}"; # sib_color_gradient
		Node "gradient_bump" 	= guid "{B3745FE2-3947-455A-B6BE-18CD5FF94639}"; # sib_color_gradient
		Node "uvwgen"			= guid "{C7A2CD40-4478-11D4-AE64-00A0C96E63E1}"; # sib_uvwgen
		Node "remap"			= guid "{4E57ACE4-B473-11D1-90E1-0000F804EB21}"; # mib_texture_remap
		Node "remap_bump"		= guid "{4E57ACE4-B473-11D1-90E1-0000F804EB21}"; # mib_texture_remap
		Node "basis"			= guid "{811FFAA5-2A42-47DF-B767-8DAEB5993E9C}"; # sib_bump_basis
		Node "bump"				= guid "{DA89443E-C521-4DD9-806D-90FA2806EDF8}"; # sib_bump_map
		Node "setnormal"		= guid "{2D8736C0-F37B-11D3-AE5B-00A0C96E63E1}"; # sib_setnormal
		Node "state_tex"		= guid "{BDE291C7-077A-11D2-8A1A-00A0C9892542}"; # sib_state_vector.spdl
		Node "switch"			= guid "{85C16046-BCFA-11D1-90E9-0000F804EB21}"; # sib_color_switch
		Node "color2alpha"		= guid "{523C43D8-B473-11D1-90E1-0000F804EB21}"; # mib_color_alpha
		
		#---- Texture space generator node.
		Connection "uvwgen::select"			= interface "tspace_id";
		Connection "uvwgen::selspace"		= interface "selspace";
		Connection "uvwgen::vertex"			= interface "vertex";
		Connection "uvwgen::project"		= interface "project";
		Connection "uvwgen::supp_invxform"	= interface "tsupp_invxform";
		Connection "uvwgen::seam_u"			= interface "seam_u";
		Connection "uvwgen::seam_v"			= interface "seam_v";
		Connection "uvwgen::texhomog"		= interface "texhomog";
		
		#---- Image remapping node.
		Connection "remap::input"		= "uvwgen";
		Connection "remap::alt_x"		= interface "alt_x";
		Connection "remap::alt_y"		= interface "alt_y";
		Connection "remap::alt_z"		= interface "alt_z";
		Connection "remap::torus_x"		= interface "wrap_u";
		Connection "remap::torus_y"		= interface "wrap_v";
		Connection "remap::torus_z"		= interface "wrap_w";
		Connection "remap::repeat"		= interface "repeats";
		Connection "remap::transform"	= interface "tproj_xform";
		Connection "remap::min"			= interface "min";
		Connection "remap::max"			= interface "max";
		
		Connection "gradient::coord"					= "remap";
		Connection "gradient::input_type"				= value 1;
		Connection "gradient::gradient_type"			= interface "gradient_type";
		Connection "gradient::invert"					= interface "invert";
		Connection "gradient::clip"						= interface "clip";
		Connection "gradient::enable_alpha_gradient"	= interface "enable_alpha_gradient";
		Connection "gradient::min"						= interface "range_min";
		Connection "gradient::max"						= interface "range_max";
		Connection "gradient::rgba_interpolation"		= interface "rgba_interpolation";
		Connection "gradient::color1"					= interface "color1";
		Connection "gradient::pos_color1"				= interface "pos_color1";
		Connection "gradient::mid_color1"				= interface "mid_color1";
		Connection "gradient::color2"					= interface "color2";
